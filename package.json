{
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "4.14.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "name": "englishreading",
  "private": true,
  "version": "0.1.0-beta",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test tests/content/*.test.mjs",
    "build": "npm run content:validate && vite build && npm run content:build",
    "test:e2e": "playwright test",
    "content:validate": "node tools/content/compile.mjs validate",
    "content:build": "node tools/content/compile.mjs build && node tools/pwa/build.mjs dist",
    "content:export": "node tools/content/pages-content.mjs export",
    "build:pages": "vite build && node tools/content/pages-content.mjs install && node tools/pwa/build.mjs dist"
  }
}
