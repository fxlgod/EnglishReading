":33,"surface":"person","lemma":"person","pos":"名词","gloss_zh":"人"},{"start":34,"end":36,"surface":"in","lemma":"in","pos":"介词","gloss_zh":"处于"},{"start":37,"end":46,"surface":"isolation","lemma":"isolation","pos":"名词","gloss_zh":"孤立"},{"start":48,"end":51,"surface":"the","lemma":"the","pos":"定冠词","gloss_zh":"这些"},{"start":52,"end":63,"surface":"researchers","lemma":"researcher","pos":"名词","gloss_zh":"研究人员"},{"start":64,"end":72,"surface":"examined","lemma":"examine","pos":"动词","gloss_zh":"考察"},{"start":73,"end":87,"surface":"brain-to-brain","lemma":"brain-to-brain","pos":"形容词","gloss_zh":"脑与脑之间的"},{"start":88,"end":97,"surface":"synchrony","lemma":"synchrony","pos":"名词","gloss_zh":"同步性"},{"start":98,"end":105,"surface":"whether","lemma":"whether","pos":"从属连词","gloss_zh":"是否"},{"start":106,"end":109,"surface":"the","lemma":"the","pos":"定冠词","gloss_zh":"这些"},{"start":110,"end":118,"surface":"students","lemma":"student","pos":"名词所有格","gloss_zh":"学生们的"},{"start":120,"end":125,"surface":"brain","lemma":"brain","pos":"名词","gloss_zh":"大脑"},{"start":126,"end":131,"surface":"waves","lemma":"wave","pos":"名词","gloss_zh":"波"},{"start":132,"end":136,"surface":"rose","lemma":"rise","pos":"动词","gloss_zh":"上升"},{"start":137,"end":140,"surface":"and","lemma":"and","pos":"连词","gloss_zh":"和"},{"start":141,"end":145,"surface":"fell","lemma":"fall","pos":"动词","gloss_zh":"下降"},{"start":146,"end":154,"surface":"together","lemma":"together","pos":"副词","gloss_zh":"一同"},{"start":155,"end":161,"surface":"during","lemma":"during","pos":"介词","gloss_zh":"在……期间"},{"start":162,"end":170,"surface":"lectures","lemma":"lecture","pos":"名词","gloss_zh":"讲座；授课"},{"start":172,"end":183,"surface":"educational","lemma":"educational","pos":"形容词","gloss_zh":"教育的"},{"start":184,"end":190,"surface":"videos","lemma":"video","pos":"名词","gloss_zh":"视频"},{"start":192,"end":195,"surface":"and","lemma":"and","pos":"连词","gloss_zh":"和"},{"start":196,"end":201,"surface":"group","lemma":"group","pos":"名词","gloss_zh":"小组"},{"start":202,"end":213,"surface":"discussions","lemma":"discussion","pos":"名词","gloss_zh":"讨论"}],"phrases":[{"start":0,"end":11,"surface":"Rather than","gloss_zh":"而不是"},{"start":34,"end":46,"surface":"in isolation","gloss_zh":"孤立地"},{"start":73,"end":97,"surface":"brain-to-brain synchrony","gloss_zh":"脑间同步性"},{"start":120,"end":131,"surface":"brain waves","gloss_zh":"脑电波"},{"start":196,"end":213,"surface":"group discussions","gloss_zh":"小组讨论"}]},{"id":"s15","text":"Interestingly, the study found that students who reported being more actively engaged in class showed greater neural synchrony with their classmates.","separator_after":"","translation_zh":"有趣的是，研究发现，自报在课堂上更积极投入的学生，与同班同学展现出了更强的神经同步性。","tokens":[{"start":0,"end":13,"surface":"Interestingly","lemma":"interestingly","pos":"副词","gloss_zh":"有趣的是"},{"start":15,"end":18,"surface":"the","lemma":"the","pos":"定冠词","gloss_zh":"这项"},{"start":19,"end":24,"surface":"study","lemma":"study","pos":"名词","gloss_zh":"研究"},{"start":25,"end":30,"surface":"found","lemma":"find","pos":"动词","gloss_zh":"发现"},{"start":31,"end":35,"surface":"that","lemma":"that","pos":"从属连词","gloss_zh":"即"},{"start":36,"end":44,"surface":"students","lemma":"student","pos":"名词","gloss_zh":"学生"},{"start":45,"end":48,"surface":"who","lemma":"who","pos":"关系代词","gloss_zh":"那些"},{"start":49,"end":57,"surface":"reported","lemma":"report","pos":"动词","gloss_zh":"自报"},{"start":58,"end":63,"surface":"being","lemma":"be","pos":"系动词","gloss_zh":"处于"},{"start":64,"end":68,"surface":"more","lemma":"more","pos":"副词","gloss_zh":"更"},{"start":69,"end":77,"surface":"actively","lemma":"actively","pos":"副词","gloss_zh":"积极地"},{"start":78,"end":85,"surface":"engaged","lemma":"engage","pos":"形容词","gloss_zh":"投入的"},{"start":86,"end":88,"surface":"in","lemma":"in","pos":"介词","gloss_zh":"在……中"},{"start":89,"end":94,"surface":"class","lemma":"class","pos":"名词","gloss_zh":"课堂"},{"start":95,"end":101,"surface":"showed","lemma":"show","pos":"动词","gloss_zh":"表现出"},{"start":102,"end":109,"surface":"greater","lemma":"great","pos":"形容词比较级","gloss_zh":"更强的"},{"start":110,"end":116,"surface":"neural","lemma":"neural","pos":"形容词","gloss_zh":"神经的"},{"start":117,"end":126,"surface":"synchrony","lemma":"synchrony","pos":"名词","gloss_zh":"同步性"},{"start":127,"end":131,"surface":"with","lemma":"with","pos":"介词","gloss_zh":"与……"},{"start":132,"end":137,"surface":"their","lemma":"they","pos":"代词","gloss_zh":"他们的"},{"start":138,"end":148,"surface":"classmates","lemma":"classmate","pos":"名词","gloss_zh":"同班同学"}],"phrases":[{"start":78,"end":88,"surface":"engaged in","gloss_zh":"参与；投入于"},{"start":110,"end":126,"surface":"neural synchrony","gloss_zh":"神经同步性"}]}]},{"sentences":[{"id":"s16","text":"However, portable EEG comes with scientific trade-offs.","separator_after":" ","translation_zh":"然而，便携式脑电技术也伴随着科学上的权衡与妥协。","tokens":[{"start":0,"end":7,"surface":"However","lemma":"however","pos":"副词","gloss_zh":"然而"},{"start":9,"end":17,"surface":"portable","lemma":"portable","pos":"形容词","gloss_zh":"便携的"},{"start":18,"end":21,"surface":"EEG","lemma":"EEG","pos":"名词","gloss_zh":"脑电"},{"start":22,"end":27,"surface":"comes","lemma":"come","pos":"动词","gloss_zh":"伴随"},{"start":28,"end":32,"surface":"with","lemma":"with","pos":"介词","gloss_zh":"具有"},{"start":33,"end":43,"surface":"scientific","lemma":"scientific","pos":"形容词","gloss_zh":"科学的"},{"start":44,"end":54,"surface":"trade-offs","lemma":"trade-off","pos":"名词","gloss_zh":"权衡取舍"}],"phrases":[{"start":22,"end":32,"surface":"comes with","gloss_zh":"伴随；具有"}]},{"id":"s17","text":"Portable headsets have far fewer sensors than laboratory equipment, and everyday body movements can introduce electrical noise into the recordings.","separator_after":" ","translation_zh":"便携式头戴设备的传感器数量远少于实验室设备，而且日常身体动作也可能给记录数据引入电噪声干扰。","tokens":[{"start":0,"end":8,"surface":"Portable","lemma":"portable","pos":"形容词","gloss_zh":"便携的"},{"start":9,"end":17,"surface":"headsets","lemma":"headset","pos":"名词","gloss_zh":"头戴设备"},{"start":18,"end":22,"s