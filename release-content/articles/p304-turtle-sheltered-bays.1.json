，表示在那里"},{"start":50,"end":53,"surface":"the","lemma":"the","pos":"冠词","gloss_zh":"这片"},{"start":54,"end":59,"surface":"water","lemma":"water","pos":"名词","gloss_zh":"水域；海水"},{"start":60,"end":62,"surface":"is","lemma":"be","pos":"动词","gloss_zh":"是；处于……状态"},{"start":63,"end":70,"surface":"rougher","lemma":"rough","pos":"形容词","gloss_zh":"更汹涌的；风浪更大的"}],"phrases":[{"start":27,"end":42,"surface":"more open shore","gloss_zh":"更为开阔的海岸"}]},{"id":"s3","text":"The two places may be quite close, but they offer a young turtle very different things.","separator_after":"","translation_zh":"这两个地方可能距离相当近，但它们为年轻的海龟提供的生存条件却截然不同。","tokens":[{"start":0,"end":3,"surface":"The","lemma":"the","pos":"冠词","gloss_zh":"这两个"},{"start":4,"end":7,"surface":"two","lemma":"two","pos":"数词","gloss_zh":"两"},{"start":8,"end":14,"surface":"places","lemma":"place","pos":"名词","gloss_zh":"地方；地点"},{"start":15,"end":18,"surface":"may","lemma":"may","pos":"情态动词","gloss_zh":"可能"},{"start":19,"end":21,"surface":"be","lemma":"be","pos":"动词","gloss_zh":"是；处于"},{"start":22,"end":27,"surface":"quite","lemma":"quite","pos":"副词","gloss_zh":"相当；十分"},{"start":28,"end":33,"surface":"close","lemma":"close","pos":"形容词","gloss_zh":"接近的；靠近的"},{"start":35,"end":38,"surface":"but","lemma":"but","pos":"连词","gloss_zh":"但是"},{"start":39,"end":43,"surface":"they","lemma":"they","pos":"代词","gloss_zh":"它们（指两处水域）"},{"start":44,"end":49,"surface":"offer","lemma":"offer","pos":"动词","gloss_zh":"提供；给予"},{"start":50,"end":51,"surface":"a","lemma":"a","pos":"冠词","gloss_zh":"一只"},{"start":52,"end":57,"surface":"young","lemma":"young","pos":"形容词","gloss_zh":"年轻的；幼年的"},{"start":58,"end":64,"surface":"turtle","lemma":"turtle","pos":"名词","gloss_zh":"海龟"},{"start":65,"end":69,"surface":"very","lemma":"very","pos":"副词","gloss_zh":"非常"},{"start":70,"end":79,"surface":"different","lemma":"different","pos":"形容词","gloss_zh":"不同的"},{"start":80,"end":86,"surface":"things","lemma":"thing","pos":"名词","gloss_zh":"东西；生存条件"}],"phrases":[{"start":22,"end":33,"surface":"quite close","gloss_zh":"相当近"}]}]},{"sentences":[{"id":"s4","text":"Young sea turtles need a place to feed as they grow.","separator_after":" ","translation_zh":"幼年海龟在成长过程中需要觅食的地方。","tokens":[{"start":0,"end":5,"surface":"Young","lemma":"young","pos":"形容词","gloss_zh":"年轻的；幼年的"},{"start":6,"end":9,"surface":"sea","lemma":"sea","pos":"名词","gloss_zh":"海（修饰turtles）"},{"start":10,"end":17,"surface":"turtles","lemma":"turtle","pos":"名词","gloss_zh":"海龟（复数）"},{"start":18,"end":22,"surface":"need","lemma":"need","pos":"动词","gloss_zh":"需要"},{"start":23,"end":24,"surface":"a","lemma":"a","pos":"冠词","gloss_zh":"一个"},{"start":25,"end":30,"surface":"place","lemma":"place","pos":"名词","gloss_zh":"地方；场所"},{"start":31,"end":33,"surface":"to","lemma":"to","pos":"动词不定式符号","gloss_zh":"（作后置定语修饰名词）用于"},{"start":34,"end":38,"surface":"feed","lemma":"feed","pos":"动词","gloss_zh":"觅食；进食"},{"start":39,"end":41,"surface":"as","lemma":"as","pos":"连词","gloss_zh":"随着；在……过程中"},{"start":42,"end":46,"surface":"they","lemma":"they","pos":"代词","gloss_zh":"它们（指幼龟）"},{"start":47,"end":51,"surface":"grow","lemma":"grow","pos":"动词","gloss_zh":"成长；长大"}],"phrases":[{"start":6,"end":17,"surface":"sea turtles","gloss_zh":"海龟"}]},{"id":"s5","text":"The kind of food they look for depends partly on their species.","separator_after":" ","translation_zh":"它们寻找的食物种类，在一定程度上取决于它们的物种分类。","tokens":[{"start":0,"end":3,"surface":"The","lemma":"the","pos":"冠词","gloss_zh":"这种"},{"start":4,"end":8,"surface":"kind","lemma":"kind","pos":"名词","gloss_zh":"种类"},{"start":9,"end":11,"surface":"of","lemma":"of","pos":"介词","gloss_zh":"……的"},{"start":12,"end":16,"surface":"food","lemma":"food","pos":"名词","gloss_zh":"食物"},{"start":17,"end":21,"surface":"they","lemma":"they","pos":"代词","gloss_zh":"它们"},{"start":22,"end":26,"surface":"look","lemma":"look","pos":"动词","gloss_zh":"看；寻找（与for连用）"},{"start":27,"end":30,"surface":"for","lemma":"for","pos":"介词","gloss_zh":"寻找……"},{"start":31,"end":38,"surface":"depends","lemma":"de