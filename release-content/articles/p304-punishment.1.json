 sick.","separator_after":"","translation_zh":"拉希姆开始感到不舒服了。","tokens":[{"start":0,"end":5,"surface":"Rahim","lemma":"Rahim","pos":"专有名词","gloss_zh":"拉希姆（人名）"},{"start":6,"end":12,"surface":"starts","lemma":"start","pos":"动词","gloss_zh":"开始"},{"start":13,"end":15,"surface":"to","lemma":"to","pos":"不定式标记","gloss_zh":"去"},{"start":16,"end":20,"surface":"feel","lemma":"feel","pos":"动词","gloss_zh":"感觉；觉得"},{"start":21,"end":25,"surface":"sick","lemma":"sick","pos":"形容词","gloss_zh":"恶心的；不舒服的"}],"phrases":[{"start":16,"end":25,"surface":"feel sick","gloss_zh":"感觉恶心；不舒服"}]}]},{"sentences":[{"id":"s15","text":"“My tummy is so sore,” whispers Rahim.","separator_after":"","translation_zh":"“我的肚子太疼了，”拉希姆低声哼唧道。","tokens":[{"start":1,"end":3,"surface":"My","lemma":"my","pos":"代词","gloss_zh":"我的"},{"start":4,"end":9,"surface":"tummy","lemma":"tummy","pos":"名词","gloss_zh":"肚子；胃"},{"start":10,"end":12,"surface":"is","lemma":"be","pos":"系动词","gloss_zh":"是"},{"start":13,"end":15,"surface":"so","lemma":"so","pos":"副词","gloss_zh":"如此；这么"},{"start":16,"end":20,"surface":"sore","lemma":"sore","pos":"形容词","gloss_zh":"疼痛的；酸痛的"},{"start":23,"end":31,"surface":"whispers","lemma":"whisper","pos":"动词","gloss_zh":"低语；咕哝"},{"start":32,"end":37,"surface":"Rahim","lemma":"Rahim","pos":"专有名词","gloss_zh":"拉希姆（人名）"}],"phrases":[]}]},{"sentences":[{"id":"s16","text":"Mama knew this would happen.","separator_after":" ","translation_zh":"妈妈早就料到会这样。","tokens":[{"start":0,"end":4,"surface":"Mama","lemma":"mama","pos":"名词","gloss_zh":"妈妈"},{"start":5,"end":9,"surface":"knew","lemma":"know","pos":"动词","gloss_zh":"知道；料到"},{"start":10,"end":14,"surface":"this","lemma":"this","pos":"代词","gloss_zh":"这；这事"},{"start":15,"end":20,"surface":"would","lemma":"would","pos":"助动词","gloss_zh":"将；会"},{"start":21,"end":27,"surface":"happen","lemma":"happen","pos":"动词","gloss_zh":"发生"}],"phrases":[]},{"id":"s17","text":"The fruit is punishing Rahim!","separator_after":"","translation_zh":"是水果在惩罚拉希姆呢！","tokens":[{"start":0,"e