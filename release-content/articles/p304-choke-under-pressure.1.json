,"end":46,"surface":"working memory","gloss_zh":"工作记忆"},{"start":72,"end":86,"surface":"solve problems","gloss_zh":"解决问题"},{"start":111,"end":127,"surface":"long-term memory","gloss_zh":"长时记忆"}]},{"id":"s13","text":"But in high-pressure situations, worries about grades or running out of time can intrude.","separator_after":" ","translation_zh":"但在高压情境下，对分数的担忧或对时间不够用的焦虑可能会趁虚而入。","tokens":[{"start":0,"end":3,"surface":"But","lemma":"but","pos":"连词","gloss_zh":"但是"},{"start":4,"end":6,"surface":"in","lemma":"in","pos":"介词","gloss_zh":"在……中"},{"start":7,"end":20,"surface":"high-pressure","lemma":"high-pressure","pos":"形容词","gloss_zh":"高压的"},{"start":21,"end":31,"surface":"situations","lemma":"situation","pos":"名词","gloss_zh":"情境"},{"start":33,"end":40,"surface":"worries","lemma":"worry","pos":"名词","gloss_zh":"担忧"},{"start":41,"end":46,"surface":"about","lemma":"about","pos":"介词","gloss_zh":"关于"},{"start":47,"end":53,"surface":"grades","lemma":"grade","pos":"名词","gloss_zh":"成绩"},{"start":54,"end":56,"surface":"or","lemma":"or","pos":"连词","gloss_zh":"或者"},{"start":57,"end":64,"surface":"running","lemma":"run","pos":"动词","gloss_zh":"耗尽"},{"start":65,"end":68,"surface":"out","lemma":"out","pos":"副词","gloss_zh":"出去"},{"start":69,"end":71,"surface":"of","lemma":"of","pos":"介词","gloss_zh":"……的"},{"start":72,"end":76,"surface":"time","lemma":"time","pos":"名词","gloss_zh":"时间"},{"start":77,"end":80,"surface":"can","lemma":"can","pos":"情态动词","gloss_zh":"会"},{"start":81,"end":88,"surface":"intrude","lemma":"intrude","pos":"动词","gloss_zh":"侵入"}],"phrases":[{"start":57,"end":71,"surface":"running out of","gloss_zh":"耗尽；用完"}]},{"id":"s14","text":"These stressful thoughts take up valuable space in your mental workspace.","separator_after":" ","translation_zh":"这些带来压力的杂念占据了你思维工作空间中的宝贵位置。","tokens":[{"start":0,"end":5,"surface":"These","lemma":"these","pos":"限定词","gloss_zh":"这些"},{"start":6,"end":15,"surface":"stressful","lemma":"stressful","pos":"形容词","gloss_zh":"带来压力的"},{"start":16,"en