{"schema_version":2,"id":"p304-zama-great","revision":1,"title_en":"Zama Is Great!","title_zh":"了不起的扎玛！","level":"A1","primary_topic":"daily_life","tags":["daily_life","family","confidence","childhood"],"source_type":"licensed_original","fiction":true,"summary_zh":"独立能干的女孩扎玛每天清晨早起自己洗漱、系扣穿鞋，告诉弟弟学校里的消息并认真上学；在勤快完成各项生活自理之余，她最喜爱的依然是尽情开心地玩耍。","featured":false,"admitted_at":"2026-11-22T05:40:23Z","paragraphs":[{"sentences":[{"id":"s1","text":"My little brother sleeps very late.","separator_after":" ","translation_zh":"我的小弟弟总是睡到很晚才起。","tokens":[{"start":0,"end":2,"surface":"My","lemma":"my","pos":"代词","gloss_zh":"我的"},{"start":3,"end":9,"surface":"little","lemma":"little","pos":"形容词","gloss_zh":"年幼的；小的"},{"start":10,"end":17,"surface":"brother","lemma":"brother","pos":"名词","gloss_zh":"弟弟"},{"start":18,"end":24,"surface":"sleeps","lemma":"sleep","pos":"动词","gloss_zh":"睡觉"},{"start":25,"end":29,"surface":"very","lemma":"very","pos":"副词","gloss_zh":"非常"},{"start":30,"end":34,"surface":"late","lemma":"late","pos":"副词","gloss_zh":"晚"}],"phrases":[{"start":0,"end":17,"surface":"My little brother","gloss_zh":"我的小弟弟"}]},{"id":"s2","text":"I wake early, because I am great!","separator_after":"","translation_zh":"我起得很早，因为我很棒！","tokens":[{"start":0,"end":1,"surface":"I","lemma":"I","pos":"代词","gloss_zh":"我"},{"start":2,"end":6,"surface":"wake","lemma":"wake","pos":"动词","gloss_zh":"醒来；早起"},{"start":7,"end":12,"surface":"early","lemma":"early","pos":"副词","gloss_zh":"早"},{"start":14,"end":21,"surface":"because","lemma":"because","pos":"连词","gloss_zh":"因为"},{"start":22,"end":23,"surface":"I","lemma":"I","pos":"代词","gloss_zh":"我"},{"start":24,"end":26,"surface":"am","lemma":"be","pos":"系动词","gloss_zh":"是"},{"start":27,"end":32,"surface":"great","lemma":"great","pos":"形容词","gloss_zh":"棒的；了不起的"}],"phrases":[]}]},{"sentences":[{"id":"s3","text":"I am the one who lets in the sun.","separator_after":"","translation_zh":"我是那个迎进阳光的人。","tokens":[{"start":0,"end":1,"surface":"I","lemma":"I","pos":"