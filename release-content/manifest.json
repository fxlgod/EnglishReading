{"schema_version":2,"build_id":"release-a9d789c783841ee4e2f815b8f06b33e77ad47dc445f08fc32c4ed32cbcc4c077","content_version":"a9d789c783841ee4e2f815b8f06b33e77ad47dc445f08fc32c4ed32cbcc4c077","articles":[{"id":"p304-adolescent-brain","revision":1,"title_en":"The Adolescent Brain Is Literally Awesome","title_zh":"青春期大脑真的很惊艳","level":"B1","primary_topic":"psychology_science","tags":["science","neuroscience","adolescence"],"source_type":"licensed_adaptation","fiction":false,"summary_zh":"青春期是童年通向成年的桥梁。现代脑成像研究表明，人类大脑发育会一直持续到二十多岁。青春期期间，灰质逐渐减少反映了神经突触连接的精细修剪，而白质纤维的增加支持了大脑跨区域的高速通信。科学家指出，情绪社交脑区与理性规划脑区可能具有不同的发育时间线，这或能解释青少年对新鲜体验的渴望，但个体差异非常显著。充满可塑性的大脑为青少年提供了探索与学习的黄金机遇。","featured":false,"admitted_at":"2026-11-21T12:55:44Z","word_count":298,"path":"articles/p304-adolescent-brain.1.json","sha256":"344cc0dbac9014ae569b39b16fd27fa3b0c94f0e72de6457c048f66c855e8e11"},{"id":"p304-amazing-daisy","revision":1,"title_en":"Amazing Daisy","title_zh":"了不起的黛西","level":"B1","primary_topic":"adventure","tags":["adventure","animals","courage","dreams"],"source_type":"licensed_original","fiction":true,"summary_zh":"小鸡黛西梦想翱翔蓝天，面对同伴的嘲笑与质疑，她坚持每天练习振翅；在一次次跌倒后，她在圆顶小屋顶端迎风起飞，终于用坚持实现了飞翔的梦想，赢得了大家的惊叹与赞赏。","featured":false,"admitted_at":"2026-11-22T05:40:19Z","word_count":331,"path":"articles/p304-amazing-daisy.1.json","sha256":"852bc31d8f32f7b915505e16a9d91df12151c08ca187dab68f20eba3a5f386ce"},{"id":"p304-birds-thrive-cities","revision":1,"title_en":"Cities: How Do Some Birds Thrive There?","title_zh":"城市：鸟类为何能在此兴旺生存？","level":"B2","primary_topic":"psychology_science","tags":["science","ecology","birds","urban","frontiers"],"source_type":"licensed_adaptation","fiction":false,"summary_zh":"通常城市扩张会导致大型掠食动物消失，但在印度德里，猛禽黑鸢却出色地适应了人类环境并兴旺生存。生态学者在德里24个样地监测了154处黑鸢巢位，发现其食物与人类活动紧密相关：黑鸢既以街头垃圾为食，也利用居民宗教慈善投喂肉屑形成的稳定补给。GPS追踪显示亲鸟在巢周500米领地内频繁活动并定向造访投喂点；模型显示，选择在紧邻投喂点且林木繁茂处筑巢与更高的繁殖成效密切相关。这表明城市野生动物生存不仅取决于建筑道路，更取决于树木覆盖、垃圾管理与文化习俗如何交织维系生态。","featured":false,"admitted_at":"2026-11-22T03:24:41Z","word_count":409,"path":"articles/p304-birds-thrive-cities.1.json","sha256":"80cfe853bc0b4c988fea56c05e372e4d4e28bd091d779a9add1b9243fdba03e9"},{"id":"p304-blackbirds-city-noise","revision":1,"title_en":"A Blackbird’s Song on Two Sides of Vienna","title_zh":"维也纳两端的黑鸟鸣声","level":"B2","primary_topic":"psychology_science","tags":["science","animals"],"source_type":"licensed_adaptation","fiction":false,"summary_zh":"维也纳城市与林地黑鸟的鸣声存在音高和时间差异，科学家通过实地比较与声音实验探讨鸟类应对城市噪声的可能方式。","featured":false,"admitted_at":"2026-11-21T09:47:07Z","word_count":404,"path":"articles/p304-blackbirds-city-noise.1.json","sha256":"3916fe4379ec9156b8434b3a5d2c703eac612f9a5bd238ec7c47c3fa406e36a2"},{"id":"p304-brain-waves-classroom","revision":1,"title_en":"Measuring Brain Waves in the Classroom","title_zh":"在课堂中测量脑电波","level":"B2","primary_topic":"technology","tags":["science","neuroscience","technology","education"],"source_type":"licensed_adaptation","fiction":false,"summary_zh":"大脑中的860亿个神经元通过微弱电脉冲进行交流，数千神经元同步放电形成了规律起伏的脑电波。传统实验室脑电图（EEG）利用电极帽检测头皮电信号，但难以捕捉现实社交互动。纽约大学研究人员使用便携式EEG头戴设备对高中生物课进行了前沿观测，发现课堂投入度更高的学生与同学之间展现出更强的脑间电波同步性（brain-to-brain synchrony）。然而，便携式脑电也面临传感器较少、身体运动干扰等权衡，且无法读取具体思想，研究人员特此警惕对专注力分类的商业夸大宣称。","featured":false,"admitted_at":"2026-11-21T12:31:44Z","word_count":365,"path":"articles/p304-brain-waves-classroom.1.json","sha256":"85644fe3cae865995c0dcdbe614b474f9ca34555abcfcfd25efda045281ee7de"},{"id":"p304-chicken-millipede","revision":1,"title_en":"Chicken and Millipede","title_zh":"母鸡与千足虫","level":"A2","primary_topic":"literature","tags":["literature","fable","animals","storybookscanada"],"source_type":"licensed_original","fiction":true,"summary_zh":"母鸡和千足虫是一对好胜的朋友，两人相约踢足球比试本领。千足虫球技精湛大获全胜，母鸡输不起一怒之下将千足虫吞入腹中。千足虫母亲赶来寻找，千足虫在母鸡肚子里释放恶臭与怪味，令母鸡连连打嗝、咳嗽并打喷嚏将它吐出，从此母鸡和千足虫成了宿敌。","featured":false,"admitted_at":"2026-11-21T14:21:54Z","word_count":268,"path":"articles/p304-chicken-millipede.1.json","sha256":"0d4cce65a04fdf1efc3651c8c98bf5ac88707062f6db087f1f8a63fa2e239c9c"},{"id":"p304-children-of-wax","revision":1,"title_en":"Children of wax","title_zh":"蜡孩子","level":"A1","primary_topic":"literature","tags":["fiction"],"source_type":"licensed_adaptation","fiction":true,"summary_zh":"蜡做的孩子想看看太阳，兄弟们想办法帮助他。","featured":false,"admitted_at":"2026-11-21T06:51:09Z","word_count":110,"path":"articles/p304-children-of-wax.1.json","sha256":"693b75aa6877201b666322b326dc780aeac8311ef2b568d986ad529f13ed742f"},{"id":"p304-choke-under-pressure","revision":1,"title_en":"Why Do We “Choke” Under Pressure?","title_zh":"为什么我们在压力下会“发挥失常”？","level":"B1","primary_topic":"school","tags":["science","learning","psychology"],"source_type":"licensed_adaptation","fiction":false,"summary_zh":"面对重要考试或比赛时，许多人会体验到心跳加速、思维模糊和记忆受阻的“发挥失常”（choking under pressure）现象。心理学家通过工作记忆（working memory）解释了这一机制：工作记忆容量有限，当对成绩或时间的焦虑担忧侵占了宝贵的思维工作空间时，留给解题的认知资源就会减少。研究建议通过模拟实战演练、深呼吸调节以及考前将焦虑写在纸上等策略来释放工作记忆，认识到临场失常并非能力不足，而是压力下心理机制的反应。","featured":false,"admitted_at":"2026-11-21T12:30:00Z","word_count":320,"path":"articles/p304-choke-under-pressure.1.json","sha256":"708fedf0f4588aac7deb02b6f96ab846ab59b8e3eb58253b31779e459896a8e8"},{"id":"p304-decision","revision":1,"title_en":"Decision","title_zh":"重大抉择","level":"A2","primary_topic":"daily_life","tags":["daily_life","community","water","storybookscanada"],"source_type":"licensed_adaptation","fiction":true,"summary_zh":"面对村落水龙头干涸、垃圾划伤人、学童辍学等现实困境，父亲召集全村在树下召开紧急会议。在互助精神感召下，孩子们主动承诺清理废弃玻璃，妇女们负责种植粮食，男人们商定挖掘深井，全村齐心协力开启自强互助的新生活。","featured":false,"admitted_at":"2026-11-21T14:21:27Z","word_count":250,"path":"articles/p304-decision.1.json","sha256":"e3e74bbd80adf6a8d30d7882a27df8c7ac1b7acab2b2c1ef2200c82b53425670"},{"id":"p304-fish-and-gift","revision":1,"title_en":"A Fish and a Gift","title_zh":"一条鱼与一份礼物","level":"B2","primary_topic":"adventure","tags":["adventure","ocean","family","kindness"],"source_type":"licensed_original","fiction":true,"summary_zh":"开普敦拉网渔民黎明乘风出海，儿子尤素夫在岸边满怀期待；面对被困网中的小鲨鱼，父亲温柔解救小鲨鱼重归大海，黄昏时为尤素夫带回一条大鱼和一枚幸运鲨鱼齿礼物。","featured":false,"admitted_at":"2026-11-22T05:15:08Z","word_count":655,"path":"articles/p304-fish-and-gift.1.json","sha256":"6803ac959cdfaf6a85cbe37647e1f21553d3fd8866025ad38fb6621456dbf753"},{"id":"p304-goat-dog-cow","revision":1,"title_en":"Goat, Dog, and Cow","title_zh":"山羊、狗与奶牛","level":"A1","primary_topic":"adventure","tags":["fiction","adventure"],"source_type":"licensed_original","fiction":true,"summary_zh":"山羊、狗和奶牛一起坐出租车去旅行。到达终点后，奶牛如数付清了车费，狗因为没有零钱而多付了钱，山羊却趁机溜走逃票。司机十分恼火，没找零就直接开车离开。从那时起，狗总是追着汽车张望寻找欠他零钱的司机，山羊听到车声就害怕逃跑，而付清了车费的奶牛则慢条斯理地过马路。","featured":false,"admitted_at":"2026-11-21T11:21:46Z","word_count":148,"path":"articles/p304-goat-dog-cow.1.json","sha256":"2e64d700a0401c6a1857c637d308038360abff77690d982be1960efff45a91d4"},{"id":"p304-grandmas-bananas","revision":1,"title_en":"Grandma’s bananas","title_zh":"祖母的香蕉","level":"B1","primary_topic":"daily_life","tags":["fiction","daily_life"],"source_type":"licensed_adaptation","fiction":true,"summary_zh":"祖母把香蕉藏在神奇的大篮子里，我忍不住偷偷拿来吃，直到集市那天秘密终于藏不住了。","featured":false,"admitted_at":"2026-11-21T10:03:21Z","word_count":489,"path":"articles/p304-grandmas-bananas.1.json","sha256":"38c3e15d78ace69d275600f34c0e5aed5b68b036c7c962b9dcbf6c61bf8a06f8"},{"id":"p304-hen-eagle","revision":1,"title_en":"Hen and Eagle","title_zh":"母鸡与老鹰","level":"B1","primary_topic":"literature","tags":["literature","animals","folktale"],"source_type":"licensed_original","fiction":true,"summary_zh":"从前母鸡和老鹰是无法飞翔的好朋友。遭遇饥荒后，母鸡提议用捡拾的羽毛缝制翅膀，老鹰借出唯一的骨针先缝好翅膀飞上高空。母鸡因偷懒未缝好翅膀便将针借给其他鸟类，导致骨针遗失在沙堆中。愤怒的老鹰限期索回，未果后抓走小鸡作为抵押，自此母鸡总在沙地刨土寻针，老鹰则盘旋扑食雏鸡。","featured":false,"admitted_at":"2026-11-22T02:56:13Z","word_count":390,"path":"articles/p304-hen-eagle.1.json","sha256":"3071a00fc7597142376431f2aacdec900e7c44fab937b97a28eea54c18a96eb8"},{"id":"p304-hippo-wants-dance","revision":1,"title_en":"Hippo Wants to Dance","title_zh":"河马想跳舞","level":"A2","primary_topic":"adventure","tags":["adventure","animals","dance","friendship"],"source_type":"licensed_original","fiction":true,"summary_zh":"活泼的小河马想要跳舞，却因跳跃动作扬尘溅水而屡遭千足虫、翠鸟等动物劝阻；伤心落泪时蚱蜢跳到她脚边共同起舞，其他动物也纷纷前来观看。","featured":false,"admitted_at":"2026-11-22T05:40:30Z","word_count":187,"path":"articles/p304-hippo-wants-dance.1.json","sha256":"2fa08d2f1bd4462e59259cd0599e433bcfb0b99a5f7d4b79fd2d872ae2ac7132"},{"id":"p304-holidays-grandmother","revision":1,"title_en":"Holidays with grandmother","title_zh":"与祖母共度的假期","level":"B1","primary_topic":"daily_life","tags":["daily_life","family","vacation"],"source_type":"licensed_adaptation","fiction":true,"summary_zh":"住在城市里的兄妹奥东戈和阿皮约期盼着学校假期，前往乡村探望祖母。在湖畔村落里，他们向慈爱勤劳的祖母学习生火、煮茶、挤牛奶、做玉米糊，并跟随祖母去市集卖农产、买生活用品。假期尾声，祖母赠送他们各种礼物，孩子们恋恋不舍地告别乡村，带着深厚的亲情重返城市校园。","featured":false,"admitted_at":"2026-11-22T02:56:16Z","word_count":437,"path":"articles/p304-holidays-grandmother.1.json","sha256":"22d477d56c94412a7b4796b1ee1fb688ab3e4f40832eb730156ba1719eac8c96"},{"id":"p304-honeyguide-bargain","revision":1,"title_en":"The Honeyguide’s revenge","title_zh":"响蜜鴷的复仇","level":"B2","primary_topic":"literature","tags":["literature","animals","folktale"],"source_type":"licensed_adaptation","fiction":true,"summary_zh":"经典的祖鲁民间生态传说，讲述响蜜鴷恩格德与贪婪年轻猎人格吉莱的故事。小鸟引路带领格吉莱在空心大树中找到了蜂巢，猎人取出诱人蜂蜜饱餐后，却背弃世代相传的互助约定，未给带路鸟留下半点蜂蜡，独自逃离。被激怒的响蜜鴷在数周后再次呼唤格吉莱，格吉莱以为又将有美餐，兴冲冲跟随小鸟穿过丛林爬上一棵无花果树，却迎面撞上一只凶猛的花豹。侥幸逃生的格吉莱自此铭记教训，而猎人们也世代告诫：永远不要忘记与响蜜鴷分享猎物。","featured":false,"admitted_at":"2026-11-22T02:56:22Z","word_count":601,"path":"articles/p304-honeyguide-bargain.1.json","sha256":"8e0239e965b385189b3187219cc941960ab3fa8c47fbb3a3d93824804a2d4538"},{"id":"p304-house-for-mouse","revision":1,"title_en":"A House for Mouse","title_zh":"老鼠的新家","level":"A1","primary_topic":"daily_life","tags":["daily_life","animals","home"],"source_type":"licensed_original","fiction":true,"summary_zh":"小老鼠四处寻找新家，先后借住小狗、鹦鹉和金鱼窝并做了各种不合适的梦，最终在温暖的书架找到了理想归宿。","featured":false,"admitted_at":"2026-11-21T17:47:23Z","word_count":95,"path":"articles/p304-house-for-mouse.1.json","sha256":"44ffc058cddf6f67162f857b6d24a3b610cd20d782aed7bc35fc72c08f8cdc0b"},{"id":"p304-left-home-city-revised","revision":1,"title_en":"The day I left home for the city","title_zh":"我动身去城里的那天","level":"B1","primary_topic":"daily_life","tags":["fiction","daily_life"],"source_type":"licensed_adaptation","fiction":true,"summary_zh":"在拥挤喧闹的车站，我带着行李独自坐上开往城里的大巴，一路上紧张地默念着叔叔的住址。","featured":false,"admitted_at":"2026-11-21T10:06:19Z","word_count":441,"path":"articles/p304-left-home-city-revised.1.json","sha256":"f4cfd56fa8b139db2fb66f6ce576bef3b10c60c9855ed848f1c06a740f226e06"},{"id":"p304-nozibele-three-hairs","revision":1,"title_en":"Nozibele and the three hairs","title_zh":"诺齐贝莱与三根头发","level":"B1","primary_topic":"mystery","tags":["fiction","folktale"],"source_type":"licensed_original","fiction":true,"summary_zh":"诺齐贝莱在河边弄丢了项链，回去寻找时误入一座奇怪的屋子，在三根会说话的头发帮助下惊险逃脱。","featured":false,"admitted_at":"2026-11-21T10:14:37Z","word_count":390,"path":"articles/p304-nozibele-three-hairs.1.json","sha256":"d807b0da63c90cafa34e48bf98d4a19ab1438830146fd10ade44fe2f54553474"},{"id":"p304-plant-air-messages","revision":1,"title_en":"Plants Can “Speak” to Each Other","title_zh":"植物之间的“对话”","level":"B1","primary_topic":"psychology_science","tags":["science","botany","chemicals","frontiers"],"source_type":"licensed_adaptation","fiction":false,"summary_zh":"当毛毛虫啃食叶片时，受创植物能向空气中释放茉莉酸甲酯等挥发性有机化合物。这些气体信号不仅能传导至同一植株未受损部位，还能扩散到临近植物，触发其提前激活防御机制。科学研究强调，这种“交流”本质上是环境中的化学信号响应，而非具有意识的语言对话。","featured":false,"admitted_at":"2026-11-21T14:22:19Z","word_count":307,"path":"articles/p304-plant-air-messages.1.json","sha256":"d9bfd2e79dde185d7d0f5250a6981663b500e3e82c4b6a9253080cb1015e00e2"},{"id":"p304-punishment","revision":1,"title_en":"Punishment","title_zh":"惩罚","level":"A1","primary_topic":"daily_life","tags":["daily_life","family","honesty"],"source_type":"licensed_original","fiction":true,"summary_zh":"拉希姆因贪心提前吃光所有水果导致肚子剧痛，最终明白自食其果的道理并真诚向家人道歉认错。","featured":false,"admitted_at":"2026-11-21T18:09:28Z","word_count":131,"path":"articles/p304-punishment.1.json","sha256":"2d3c45bb33047a02518b03a46d0ee98c47048a66fdbd92d7e0e653166dac6f6d"},{"id":"p304-simbegwire-blanket","revision":1,"title_en":"Simbegwire","title_zh":"辛贝格维尔与彩毯","level":"B2","primary_topic":"literature","tags":["literature","family","resilience","growing_up"],"source_type":"licensed_adaptation","fiction":true,"summary_zh":"失去母亲的小女孩辛贝格维尔在生母留下的温暖彩毯中寻找慰藉。当父亲迎娶新继母安妮塔后，严苛的繁重家务让女孩不堪重负。在父亲出差期间，继母的严厉惩罚与扯破的彩毯迫使她出走到溪边大树上避难。溪水旁洗衣的姑母通过歌声与彩毯认出侄女并给予庇护。得知真相后，深爱女儿的父亲赶到姑母家支持她的决定，继母也真诚登门道歉悔过。在亲情的理解、尊重与包容中，破碎的家庭最终迎来和解与希望。","featured":false,"admitted_at":"2026-11-22T02:56:25Z","word_count":794,"path":"articles/p304-simbegwire-blanket.1.json","sha256":"e6bfb3bb8372c9a892736bda2c99c0ecd6ebb50b9d7912880e3cc8fb6934cc1e"},{"id":"p304-sleep-study-schedule","revision":1,"title_en":"From ZZZs to AAAs: Why Sleep Is an Important Part of Your Study Schedule","title_zh":"从呼呼大睡到成绩全A：为什么睡眠是学习计划的重要部分","level":"B1","primary_topic":"school","tags":["science","learning","health"],"source_type":"licensed_adaptation","fiction":false,"summary_zh":"许多学生误以为熬夜复习更有效，但科学研究表明睡眠是记忆巩固不可或缺的环节。脑电研究揭示了浅睡期睡眠纺锤波与深睡期慢波在大脑重塑中的作用。科学家提出了快学习系统（海马体）与慢学习系统（大脑皮层）模型，指出深睡与午休有助于将白天的短暂记忆转化为长期知识。健康指南建议13至18岁青少年每晚保持8至10小时规律睡眠。","featured":false,"admitted_at":"2026-11-21T12:55:31Z","word_count":295,"path":"articles/p304-sleep-study-schedule.1.json","sha256":"44133fd5e541036901e729a38bf928b3d7411b19a6023ad397b0991ebc8879a1"},{"id":"p304-sleepy-sloth","revision":1,"title_en":"Sleepy Mr Sloth","title_zh":"困倦的树懒先生","level":"A2","primary_topic":"adventure","tags":["adventure","animals","poetry"],"source_type":"licensed_original","fiction":true,"summary_zh":"极度困倦的树懒先生在丛林大树寻找理想的午睡枝桠，接连遭遇长颈鹿、蜜蜂、蛇与吵闹鸟，最终在邻里动物齐声鼓励下找到理想枝桠并和谐共处。","featured":false,"admitted_at":"2026-11-21T18:09:42Z","word_count":222,"path":"articles/p304-sleepy-sloth.1.json","sha256":"d42455761f4b22242bfbd431f07a28a4c0a09dadb287e5fd1c83f6cffd0d6175"},{"id":"p304-spirit-spring","revision":1,"title_en":"Searching for the Spirit of Spring","title_zh":"寻访春之生机","level":"A2","primary_topic":"literature","tags":["literature","adventure","culture"],"source_type":"licensed_adaptation","fiction":true,"summary_zh":"在漫长严冬后，女孩恩卡涅齐踏上旅程搜寻色彩、鼓乐与美食，唤醒沉睡村庄春日节庆精神的动人旅程。","featured":false,"admitted_at":"2026-11-21T17:48:05Z","word_count":201,"path":"articles/p304-spirit-spring.1.json","sha256":"7107b63ae60e26fd4f657ebf9a42705363f49bdd8f7099d25a2c14869cea879d"},{"id":"p304-teen-brain-technology","revision":1,"title_en":"Mind Games: Technology and the Developing Teenage Brain","title_zh":"心智博弈：数字科技与发育中的青少年大脑","level":"B2","primary_topic":"technology","tags":["technology","neuroscience","adolescence","frontiers"],"source_type":"licensed_adaptation","fiction":false,"summary_zh":"神经科学研究显示，青少年时期社会情感网络（处理奖赏与同伴反馈）与认知控制网络（负责规划与冲动控制）的发育节奏存在时差，这解释了为何在线点赞和通知格外诱人。大规模调查揭示了适度屏幕使用的“金发姑娘假说”，即极少或极度沉迷均伴随较低主观幸福感，而主动的高品质数字互动（如创作、视频学习与深度交流）有助于身心健康。科学家建议青少年建立规律作息并保护睡眠，实现对数字生活的理性自主掌控。","featured":false,"admitted_at":"2026-11-21T14:33:35Z","word_count":384,"path":"articles/p304-teen-brain-technology.1.json","sha256":"80239cc4f11fddcfbabaf35e2bd6e8d641b21dd9974a1ea7313c796c9839a10b"},{"id":"p304-tingi-cows","revision":1,"title_en":"Tingi and the cows","title_zh":"廷吉和牛","level":"A1","primary_topic":"adventure","tags":["fiction"],"source_type":"licensed_adaptation","fiction":true,"summary_zh":"士兵带走了牛。廷吉和祖母躲了起来。","featured":false,"admitted_at":"2026-11-21T06:51:06Z","word_count":81,"path":"articles/p304-tingi-cows.1.json","sha256":"ce6974fada0878828862f430cca84b0272b8e2de0a270115ab811e5ba0c3561b"},{"id":"p304-tortoise-finds-home","revision":1,"title_en":"Tortoise Finds His Home","title_zh":"乌龟找到自己的家","level":"B1","primary_topic":"adventure","tags":["adventure","animals","home","journey"],"source_type":"licensed_original","fiction":true,"summary_zh":"小乌龟在旷野苦苦寻觅属于自己的房子，在一路搭载蜗牛、麻雀、瓢虫和小鼠等朋友后遭遇狂风暴雨；狂风将朋友们吹走，受惊的小乌龟缩回壳中，终于领悟温暖坚固的龟壳就是自己最好的家园。","featured":false,"admitted_at":"2026-11-22T05:14:57Z","word_count":363,"path":"articles/p304-tortoise-finds-home.1.json","sha256":"e9b17230154de8cd02582c9355305d865dcb14404090c0df456c552753b7ae54"},{"id":"p304-turtle-sheltered-bays","revision":1,"title_en":"Why Young Sea Turtles May Stay in a Bay","title_zh":"年轻海龟为何常留在海湾","level":"B1","primary_topic":"psychology_science","tags":["science","animals"],"source_type":"licensed_adaptation","fiction":false,"summary_zh":"研究人员在哥斯达黎加海湾观察到年轻的玳瑁海龟，分析平静的海湾如何为幼龟提供丰富的食物和躲避风浪的场所。","featured":false,"admitted_at":"2026-11-21T10:03:40Z","word_count":308,"path":"articles/p304-turtle-sheltered-bays.1.json","sha256":"5d34e47cd1319838ac94ed9045fe7ec83a78efbfd52e11d24fb3456192dfccb7"},{"id":"p304-vusi-wedding","revision":1,"title_en":"What Vusi’s sister said","title_zh":"乌西姐姐的回答","level":"B1","primary_topic":"literature","tags":["literature","family","folktale"],"source_type":"licensed_adaptation","fiction":true,"summary_zh":"小男孩乌西受祖母之托，送鸡蛋去给父母制作姐姐婚礼的大蛋糕。路上他遭遇了一连串意外：顽皮小男孩砸碎了鸡蛋，用弹弓补偿；修剪树枝的工人们弄断了弹弓，用木柴补偿；烘焙面包的师傅们把木柴烧掉，用新鲜面包补偿；牧牛人饥饿抢食了面包，用拐杖补偿。最后乌西不慎把拐杖掉进草丛摔成两截，失落赶到婚礼现场。然而深爱弟弟的姐姐温柔开导他，告诉他最珍贵的礼物是弟弟平安盛装出席，两人共同在喜悦中起舞。","featured":false,"admitted_at":"2026-11-22T02:56:19Z","word_count":492,"path":"articles/p304-vusi-wedding.1.json","sha256":"f6bdc0f593ca132923566104996bc857bf6f7dbd70f65dcec4b42fc6c89161b9"},{"id":"p304-walking-together","revision":1,"title_en":"Walking Together","title_zh":"结伴同行","level":"A2","primary_topic":"daily_life","tags":["daily_life","family","courage","journey"],"source_type":"licensed_original","fiction":true,"summary_zh":"母亲一路相伴女儿步行前往诊所体检，以温暖诗意与鼓励克服对体检的恐惧与路途疲倦；体检后二人一同回家，母亲在温馨中向女儿道晚安就寝。","featured":false,"admitted_at":"2026-11-22T05:40:26Z","word_count":216,"path":"articles/p304-walking-together.1.json","sha256":"e74609fe083bc4f14975b76b9cbb4cb5c897cc1d8c75db50568369f3e1555086"},{"id":"p304-why-hippos-no-hair","revision":1,"title_en":"Why Hippos Have No Hair","title_zh":"河马为什么没有毛发（民间故事）","level":"A2","primary_topic":"adventure","tags":["fiction","adventure"],"source_type":"licensed_original","fiction":true,"summary_zh":"这是一则虚构的非洲民间起源传说，并非真实生物学解释。河马散步时不小心踩到了野兔的脚，虽然真诚道歉，但野兔怀恨在心，让大火烧光了河马漂亮的毛发。河马痛哭着跳进水里，从此因为害怕大火而再也不敢远离河水。","featured":false,"admitted_at":"2026-11-21T12:55:13Z","word_