acticed","lemma":"practice","pos":"动词","gloss_zh":"练习过"},{"start":110,"end":114,"surface":"just","lemma":"just","pos":"副词","gloss_zh":"就在"},{"start":115,"end":124,"surface":"yesterday","lemma":"yesterday","pos":"名词","gloss_zh":"昨天"}],"phrases":[{"start":67,"end":78,"surface":"struggle to","gloss_zh":"费力地做某事"}]}]},{"sentences":[{"id":"s5","text":"Psychologists call this experience choking under pressure.","separator_after":" ","translation_zh":"心理学家将这种经历称为“压力下发挥失常”（choking under pressure）。","tokens":[{"start":0,"end":13,"surface":"Psychologists","lemma":"psychologist","pos":"名词","gloss_zh":"心理学家"},{"start":14,"end":18,"surface":"call","lemma":"call","pos":"动词","gloss_zh":"称作"},{"start":19,"end":23,"surface":"this","lemma":"this","pos":"限定词","gloss_zh":"这种"},{"start":24,"end":34,"surface":"experience","lemma":"experience","pos":"名词","gloss_zh":"经历"},{"start":35,"end":42,"surface":"choking","lemma":"choke","pos":"动词","gloss_zh":"噎住；失常"},{"start":43,"end":48,"surface":"under","lemma":"under","pos":"介词","gloss_zh":"在……下"},{"start":49,"end":57,"surface":"pressure","lemma":"pressure","pos":"名词","gloss_zh":"压力"}],"phrases":[{"start":35,"end":57,"surface":"choking under pressure","gloss_zh":"压力下发挥失常"}]},{"id":"s6","text":"It does not mean you have trouble breathing.","separator_after":" ","translation_zh":"这并不意味着你呼吸困难。","tokens":[{"start":0,"end":2,"surface":"It","lemma":"it","pos":"代词","gloss_zh":"它"},{"start":3,"end":7,"surface":"does","lemma":"do","pos":"助动词","gloss_zh":"并不"},{"start":8,"end":11,"surface":"not","lemma":"not","pos":"副词","gloss_zh":"不"},{"start":12,"end":16,"surface":"mean","lemma":"mean","pos":"动词","gloss_zh":"意味着"},{"start":17,"end":20,"surface":"you","lemma":"you","pos":"代词","gloss_zh":"你"},{"start":21,"end":25,"surface":"have","lemma":"have","pos":"动词","gloss_zh":"有"},{"start":26,"end":33,"surface":"trouble","lemma":"trouble","pos":"名词","gloss_zh":"困难"},{"start":34,"end":43,"surface":"breathing","lemma":"breathe","pos":"动词","gloss_zh":"呼吸"}],"phrases":[{"start":21,"end":43,"surface":"have trouble breathing","gloss_zh":"呼吸困难"}]},{"id":"s7","text":"Instead, it describes what happens when anxiety causes someone to perform worse than usual on a task they have already practiced or mastered.","separator_after":" ","translation_zh":"相反，它描述的是当焦虑导致某人在一项早已练过或掌握的任务中表现得比平时更差的现象。","tokens":[{"start":0,"end":7,"surface":"Instead","lemma":"instead","pos":"副词","gloss_zh":"相反"},{"start":9,"end":11,"surface":"it","lemma":"it","pos":"代词","gloss_zh":"它"},{"start":12,"end":21,"surface":"describes","lemma":"describe","pos":"动词","gloss_zh":"描述"},{"start":22,"end":26,"surface":"what","lemma":"what","pos":"代词","gloss_zh":"所发生的情形"},{"start":27,"end":34,"surface":"happens","lemma":"happen","pos":"动词","gloss_zh":"发生"},{"start":35,"end":39,"surface":"when","lemma":"when","pos":"连词","gloss_zh":"当……时"},{"start":40,"end":47,"surface":"anxiety","lemma":"anxiety","pos":"名词","gloss_zh":"焦虑"},{"start":48,"end":54,"surface":"causes","lemma":"cause","pos":"动词","gloss_zh":"导致"},{"start":55,"end":62,"surface":"someone","lemma":"someone","pos":"代词","gloss_zh":"某人"},{"start":63,"end":65,"surface":"to","lemma":"to","pos":"不定式标记","gloss_zh":"去"},{"start":66,"end":73,"surface":"perform","lemma":"perform","pos":"动词","gloss_zh":"表现"},{"start":74,"end":79,"surface":"worse","lemma":"bad","pos":"副词","gloss_zh":"更差"},{"start":80,"end":84,"surface":"than","lemma":"than","pos":"介词","gloss_zh":"比"},{"start":85,"end":90,"surface":"usual","lemma":"usual","pos":"形容词","gloss_zh":"平时"},{"start":91,"end":93,"surface":"on","lemma":"on","pos":"介词","gloss_zh":"在……方面"},{"start":94,"end":95,"surface":"a","lemma":"a","pos":"冠词","gloss_zh":"一项"},{"start":96,"end":100,"surface":"task","lemma":"task","pos":"名词","gloss_zh":"任务"},{"start":101,"end":105,"surface":"they","lemma":"they","pos":"代词","gloss_zh":"他们"},{"start":106,"end":110,"surface":"have","lemma":"have","pos":"助动词","gloss_zh":"已经"},{"start":111,"end":118,"surface":"already","lemma":"already","pos":"副词","gloss_zh":"早就"},{"