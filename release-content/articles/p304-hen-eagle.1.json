,{"start":32,"end":40,"surface":"feathers","lemma":"feather","pos":"名词","gloss_zh":"羽毛"},{"start":41,"end":45,"surface":"from","lemma":"from","pos":"介词","gloss_zh":"从……那里"},{"start":46,"end":49,"surface":"all","lemma":"all","pos":"限定词","gloss_zh":"所有"},{"start":50,"end":55,"surface":"their","lemma":"they","pos":"代词","gloss_zh":"它们的"},{"start":56,"end":60,"surface":"bird","lemma":"bird","pos":"名词","gloss_zh":"鸟类"},{"start":61,"end":68,"surface":"friends","lemma":"friend","pos":"名词","gloss_zh":"朋友"}],"phrases":[]},{"id":"s10","text":"“Let’s sew them together on top of our own feathers,” she said.","separator_after":" ","translation_zh":"“咱们把它们缝在一起，加在咱们自己的羽毛上吧，”她说。","tokens":[{"start":1,"end":6,"surface":"Let’s","lemma":"let us","pos":"动词＋代词","gloss_zh":"让我们；咱们"},{"start":7,"end":10,"surface":"sew","lemma":"sew","pos":"动词","gloss_zh":"缝制；缝"},{"start":11,"end":15,"surface":"them","lemma":"they","pos":"代词","gloss_zh":"它们"},{"start":16,"end":24,"surface":"together","lemma":"together","pos":"副词","gloss_zh":"在一起"},{"start":25,"end":27,"surface":"on","lemma":"on","pos":"介词","gloss_zh":"在……上面"},{"start":28,"end":31,"surface":"top","lemma":"top","pos":"名词","gloss_zh":"顶部"},{"start":32,"end":34,"surface":"of","lemma":"of","pos":"介词","gloss_zh":"……的"},{"start":35,"end":38,"surface":"our","lemma":"we","pos":"代词","gloss_zh":"我们的；咱们的"},{"start":39,"end":42,"surface":"own","lemma":"own","pos":"形容词","gloss_zh":"自己的"},{"start":43,"end":51,"surface":"feathers","lemma":"feather","pos":"名词","gloss_zh":"羽毛"},{"start":54,"end":57,"surface":"she","lemma":"she","pos":"代词","gloss_zh":"她"},{"start":58,"end":62,"surface":"said","lemma":"say","pos":"动词","gloss_zh":"说"}],"phrases":[{"start":25,"end":34,"surface":"on top of","gloss_zh":"在……之上；在……顶端"}]},{"id":"s11","text":"“Perhaps that will make it easier to travel.”","separator_after":"","translation_zh":"“也许那样会让出行变得更容易。”","tokens":[{"start":1,"end":8,"surface":"Perhaps","lemma":"perhaps","pos":"副词","gloss_zh":"也许；可能"},{"start":9,"end":13,"surface":"that","lemma":"that","pos":"代词","gloss_zh":"那样；那件事"},{"start":14,"end":18,"surface":"will","lemma":"will","pos":"助动词","gloss_zh":"将；会"},{"start":19,"end":23,"surface":"make","lemma":"make","pos":"动词","gloss_zh":"使得；让"},{"start":24,"end":26,"surface":"it","lemma":"it","pos":"代词","gloss_zh":"它（形式宾语）"},{"start":27,"end":33,"surface":"easier","lemma":"easy","pos":"形容词","gloss_zh":"更容易"},{"start":34,"end":36,"surface":"to","lemma":"to","pos":"不定式标记","gloss_zh":"去"},{"start":37,"end":43,"surface":"travel","lemma":"travel","pos":"动词","gloss_zh":"出行；移动"}],"phrases":[]}]},{"sentences":[{"id":"s12","text":"Eagle was the only one in the village with a needle, so she started sewing first.","separator_after":" ","translation_zh":"老鹰是村里唯一有针的鸟，所以她先开始缝制。","tokens":[{"start":0,"end":5,"surface":"Eagle","lemma":"Eagle","pos":"专有名词","gloss_zh":"老鹰"},{"start":6,"end":9,"surface":"was","lemma":"be","pos":"系动词","gloss_zh":"是"},{"start":10,"end":13,"surface":"the","lemma":"the","pos":"冠词","gloss_zh":"这个"},{"start":14,"end":18,"surface":"only","lemma":"only","pos":"形容词","gloss_zh":"唯一的"},{"start":19,"end":22,"surface":"one","lemma":"one","pos":"代词","gloss_zh":"一个"},{"start":23,"end":25,"surface":"in","lemma":"in","pos":"介词","gloss_zh":"在……之中"},{"start":26,"end":29,"surface":"the","lemma":"the","pos":"冠词","gloss_zh":"这个"},{"start":30,"end":37,"surface":"village","lemma":"village","pos":"名词","gloss_zh":"村庄"},{"start":38,"end":42,"surface":"with","lemma":"with","pos":"介词","gloss_zh":"拥有；带着"},{"start":43,"end":44,"surface":"a","lemma":"a","pos":"冠词","gloss_zh":"一根"},{"start":45,"end":51,"surface":"needle","lemma":"needle","pos":"名词","gloss_zh":"针"},{"start":53,"end":55,"surface":"so","lemma":"so","pos":"连词","gloss_zh":"所以"},{"start":56,"end":59,"surface":"she","lemma":"she","pos":"代词","gloss_zh":"她"},{"start":60,"end":67,"surface":"started","lemma":"start","pos":"动词","gloss_zh":"开始"},{"start":68,"end":74,"surface":"sewing","lemma":"sew","pos":"动词","gloss_zh":"缝制"},{"start":75,"end":80,"sur