{"schema_version":2,"id":"p304-children-of-wax","revision":1,"title_en":"Children of wax","title_zh":"蜡孩子","level":"A1","primary_topic":"literature","tags":["fiction"],"source_type":"licensed_adaptation","fiction":true,"summary_zh":"蜡做的孩子想看看太阳，兄弟们想办法帮助他。","featured":false,"admitted_at":"2026-11-21T06:51:09Z","paragraphs":[{"sentences":[{"id":"s1","text":"There was once a happy family.","separator_after":" ","translation_zh":"从前有一个幸福的家庭。","tokens":[{"start":0,"end":5,"surface":"There","lemma":"there","pos":"副词","gloss_zh":"有"},{"start":6,"end":9,"surface":"was","lemma":"be","pos":"动词","gloss_zh":"存在"},{"start":10,"end":14,"surface":"once","lemma":"once","pos":"副词","gloss_zh":"从前"},{"start":15,"end":16,"surface":"a","lemma":"a","pos":"限定词","gloss_zh":"一个"},{"start":17,"end":22,"surface":"happy","lemma":"happy","pos":"形容词","gloss_zh":"幸福的"},{"start":23,"end":29,"surface":"family","lemma":"family","pos":"名词","gloss_zh":"家庭"}],"phrases":[{"start":0,"end":14,"surface":"There was once","gloss_zh":"从前有"}]},{"id":"s2","text":"The children helped their parents at home and in the fields.","separator_after":"","translation_zh":"孩子们在家里和田地里帮助父母。","tokens":[{"start":0,"end":3,"surface":"The","lemma":"the","pos":"限定词","gloss_zh":"这些"},{"start":4,"end":12,"surface":"children","lemma":"child","pos":"名词","gloss_zh":"孩子们"},{"start":13,"end":19,"surface":"helped","lemma":"help","pos":"动词","gloss_zh":"帮助"},{"start":20,"end":25,"surface":"their","lemma":"their","pos":"代词","gloss_zh":"他们的"},{"start":26,"end":33,"surface":"parents","lemma":"parent","pos":"名词","gloss_zh":"父母"},{"start":34,"end":36,"surface":"at","lemma":"at","pos":"介词","gloss_zh":"在"},{"start":37,"end":41,"surface":"home","lemma":"home","pos":"名词","gloss_zh":"家"},{"start":42,"end":45,"surface":"and","lemma":"and","pos":"连词","gloss_zh":"和"},{"start":46,"end":48,"surface":"in","lemma":"in","pos":"介词","gloss_zh":"在"},{"start":49,"end":52,"surface":"the","lemma":"the","pos":"限定词","gloss_zh":"那些"},{"start":53,"end":59,"surface":"fields","lemma":"field","pos":"名词","gloss_zh":"田地"}],"phrases":[]}]},{"sentences":[{"id":"s3","text":"The children worked at night.","separator_after":" ","translation_zh":"孩子们在夜里干活。","tokens":[{"start":0,"end":3,"surface":"The","lemma":"the","pos":"限定词","gloss_zh":"这些"},{"start":4,"end":12,"surface":"children","lemma":"child","pos":"名词","gloss_zh":"孩子们"},{"start":13,"end":19,"surface":"worked","lemma":"work","pos":"动词","gloss_zh":"干活"},{"start":20,"end":22,"surface":"at","lemma":"at","pos":"介词","gloss_zh":"在"},{"start":23,"end":28,"surface":"night","lemma":"night","pos":"名词","gloss_zh":"夜晚"}],"phrases":[{"start":20,"end":28,"surface":"at night","gloss_zh":"在夜里"}]},{"id":"s4","text":"They did not go near a fire.","separator_after":" ","translation_zh":"他们没有靠近火。","tokens":[{"start":0,"end":4,"surface":"They","lemma":"they","pos":"代词","gloss_zh":"孩子们"},{"start":5,"end":8,"surface":"did","lemma":"do","pos":"助动词","gloss_zh":"构成过去时否定"},{"start":9,"end":12,"surface":"not","lemma":"not","pos":"副词","gloss_zh":"没有"},{"start":13,"end":15,"surface":"go","lemma":"go","pos":"动词","gloss_zh":"去"},{"start":16,"end":20,"surface":"near","lemma":"near","pos":"介词","gloss_zh":"靠近"},{"start":21,"end":22,"surface":"a","lemma":"a","pos":"限定词","gloss_zh":"一团"},{"start":23,"end":27,"surface":"fire","lemma":"fire","pos":"名词","gloss_zh":"火"}],"phrases":[]},{"id":"s5","text":"They were made of wax!","separator_after":"","translation_zh":"他们是蜡做的！","tokens":[{"start":0,"end":4,"surface":"They","lemma":"they","pos":"代词","gloss_zh":"孩子们"},{"start":5,"end":9,"surface":"were","lemma":"be","pos":"助动词","gloss_zh":"与made构成被动"},{"start":10,"end":14,"surface":"made","lemma":"make","pos":"动词","gloss_zh":"制成"},{"start":15,"end":17,"surface":"of","lemma":"of","pos":"介词","gloss_zh":"由"},{"start":18,"end":21,"surface":"wax","lemma":"wax","pos":"名词","gloss_zh":"蜡"}],"phrases":[{"start":10,"end":21,"surface":"made of wax","gloss_zh":"蜡做的"}]}]},{"sentences":[{"id":"s6","text":"One boy wanted to go out in the sun.","separator_after":" ","translation_zh":"一个男孩想走到太阳底下。","tokens":[{"start":0,"end":3,"surface":"One","lemma":"one","pos":"数词","gloss_zh":"一个"},{"start":4,"end":7,"surface":"boy","lemma":"boy","pos":"名词","gloss_zh":"男孩"},{"start":8,"end":14,"surface":"wanted","lemma":"want","pos":"动词","gloss_zh":"想要"},{"start":15,"end":17,"surface":"to","lemma":"to","pos":"不定式标记","gloss_zh":"引出想做的事"},{"start":18,"end":20,"surface":"go","lemma":"go","pos":"动词","gloss_zh":"走"},{"start":21,"end":24,"surface":"out","lemma":"out","pos":"副词","gloss_zh":"出去"},{"start":25,"end":27,"surface":"in","lemma":"in","pos":"介词","gloss_zh":"在"},{"start":28,"end":31,"surface":"the","lemma":"the","pos":"限定词","gloss_zh":"这"},{"start":32,"end":35,"surface":"sun","lemma":"sun","pos":"名词","gloss_zh":"阳光"}],"phrases":[{"start":18,"end":24,"surface":"go out","gloss_zh":"走出去"}]},{"id":"s7","text":"His brothers told him to stay inside, but he went out.","separator_after":" ","translation_zh":"他的兄弟们叫他待在屋里，但他还是出去了。","tokens":[{"start":0,"end":3,"surface":"His","lemma":"his","pos":"代词","gloss_zh":"那个男孩的"},{"start":4,"end":12,"surface":"brothers","lemma":"brother","pos":"名词","gloss_zh":"兄弟们"},{"start":13,"end":17,"surface":"told","lemma":"tell","pos":"动词","gloss_zh":"告诉"},{"start":18,"end":21,"surface":"him","lemma":"him","pos":"代词","gloss_zh":"那个男孩"},{"start":22,"end":24,"surface":"to","lemma":"to","pos":"不定式标记","gloss_zh":"引出告诉他做的事"},{"start":25,"end":29,"surface":"stay","lemma":"stay","pos":"动词","gloss_zh":"待着"},{"start":30,"end":36,"surface":"inside","lemma":"inside","pos":"副词","gloss_zh":"在屋内"},{"start":38,"end":41,"surface":"but","lemma":"but","pos":"连词","gloss_zh":"但是"},{"start":42,"end":44,"surface":"he","lemma":"he","pos":"代词","gloss_zh":"那个男孩"},{"start":45,"end":49,"surface":"went","lemma":"go","pos":"动词","gloss_zh":"走"},{"start":50,"end":53,"surface":"out","lemma":"out","pos":"副词","gloss_zh":"出去"}],"phrases":[{"start":25,"end":36,"surface":"stay inside","gloss_zh":"待在屋里"}]},{"id":"s8","text":"The sun was hot, and the boy melted.","separator_after":"","translation_zh":"太阳很热，男孩融化了。","tokens":[{"start":0,"end":3,"surface":"The","lemma":"the","pos":"限定词","gloss_zh":"这个"},{"start":4,"end":7,"surface":"sun","lemma":"sun","pos":"名词","gloss_zh":"太阳"},{"start":8,"end":11,"surface":"was","lemma":"be","pos":"动词","gloss_zh":"是"},{"start":12,"end":15,"surface":"hot","lemma":"hot","pos":"形容词","gloss_zh":"热的"},{"start":17,"end":20,"surface":"and","lemma":"and","pos":"连词","gloss_zh":"于是"},{"start":21,"end":24,"surface":"the","lemma":"the","pos":"限定词","gloss_zh":"那个"},{"start":25,"end":28,"surface":"boy","lemma":"boy","pos":"名词","gloss_zh":"男孩"},{"start":29,"end":35,"surface":"melted","lemma":"melt","pos":"动词","gloss_zh":"融化"}],"phrases":[]}]},{"sentences":[{"id":"s9","text":"His brothers were sad, but they had an idea.","separator_after":" ","translation_zh":"他的兄弟们很难过，但他们想到了一个主意。","tokens":[{"start":0,"end":3,"surface":"His","lemma":"his","pos":"代词","gloss_zh":"那个男孩的"},{"start":4,"end":12,"surface":"brothers","lemma":"brother","pos":"名词","gloss_zh":"兄弟们"},{"start":13,"end":17,"surface":"were","lemma":"be","pos":"动词","gloss_zh":"感到"},{"start":18,"end":21,"surface":"sad","lemma":"sad","pos":"形容词","gloss_zh":"难过的"},{"start":23,"end":26,"surface":"but","lemma":"but","pos":"连词","gloss_zh":"但是"},{"start":27,"end":31,"surface":"they","lemma":"they","pos":"代词","gloss_zh":"兄弟们"},{"start":32,"end":35,"surface":"had","lemma":"have","pos":"动词","gloss_zh":"有了"},{"start":36,"end":38,"surface":"an","lemma":"an","pos":"限定词","gloss_zh":"一个"},{"start":39,"end":43,"surface":"idea","lemma":"idea","pos":"名词","gloss_zh":"主意"}],"phrases":[]},{"id":"s10","text":"They took the soft wax and made it into a bird.","separator_after":" ","translation_zh":"他们拿起软软的蜡，把它做成了一只鸟。","tokens":[{"start":0,"end":4,"surface":"They","lemma":"they","pos":"代词","gloss_zh":"兄弟们"},{"start":5,"end":9,"surface":"took","lemma":"take","pos":"动词","gloss_zh":"拿起"},{"start":10,"end":13,"surface":"the","lemma":"the","pos":"限定词","gloss_zh":"这些"},{"start":14,"end":18,"surface":"soft","lemma":"soft","pos":"形容词","gloss_zh":"柔软的"},{"start":19,"end":22,"surface":"wax","lemma":"wax","pos":"名词","gloss_zh":"蜡"},{"start":23,"end":26,"surface":"and","lemma":"and","pos":"连词","gloss_zh":"然后"},{"start":27,"end":31,"surface":"made","lemma":"make","pos":"动词","gloss_zh":"做"},{"start":32,"end":34,"surface":"it","lemma":"it","pos":"代词","gloss_zh":"这些蜡"},{"start":35,"end":39,"surface":"into","lemma":"into","pos":"介词","gloss_zh":"成为"},{"start":40,"end":41,"surface":"a","lemma":"a","pos":"限定词","gloss_zh":"一只"},{"start":42,"end":46,"surface":"bird","lemma":"bird","pos":"名词","gloss_zh":"鸟"}],"phrases":[{"start":27,"end":46,"surface":"made it into a bird","gloss_zh":"把它做成一只鸟"}]},{"id":"s11","text":"Then they carried the bird up a high mountain.","separator_after":"","translation_zh":"然后他们把鸟带上了一座高山。","tokens":[{"start":0,"end":4,"surface":"Then","lemma":"then","pos":"副词","gloss_zh":"然后"},{"start":5,"end":9,"surface":"they","lemma":"they","pos":"代词","gloss_zh":"兄弟们"},{"start":10,"end":17,"surface":"carried","lemma":"carry","pos":"动词","gloss_zh":"带着"},{"start":18,"end":21,"surface":"the","lemma":"the","pos":"限定词","gloss_zh":"这只"},{"start":22,"end":26,"surface":"bird","lemma":"bird","pos":"名词","gloss_zh":"鸟"},{"start":27,"end":29,"surface":"up","lemma":"up","pos":"介词","gloss_zh":"向上到"},{"start":30,"end":31,"surface":"a","lemma":"a","pos":"限定词","gloss_zh":"一座"},{"start":32,"end":36,"surface":"high","lemma":"high","pos":"形容词","gloss_zh":"高的"},{"start":37,"end":45,"surface":"mountain","lemma":"mountain","pos":"名词","gloss_zh":"山"}],"phrases":[]}]},{"sentences":[{"id":"s12","text":"In the morning, the sun came up.","separator_after":" ","translation_zh":"早晨，太阳升起来了。","tokens":[{"start":0,"end":2,"surface":"In","lemma":"in","pos":"介词","gloss_zh":"在"},{"start":3,"end":6,"surface":"the","lemma":"the","pos":"限定词","gloss_zh":"那个"},{"start":7,"end":14,"surface":"morning","lemma":"morning","pos":"名词","gloss_zh":"早晨"},{"start":16,"end":19,"surface":"the","lemma":"the","pos":"限定词","gloss_zh":"这"},{"start":20,"end":23,"surface":"sun","lemma":"sun","pos":"名词","gloss_zh":"太阳"},{"start":24,"end":28,"surface":"came","lemma":"come","pos":"动词","gloss_zh":"来"},{"start":29,"end":31,"surface":"up","lemma":"up","pos":"副词","gloss_zh":"向上升"}],"phrases":[{"start":24,"end":31,"surface":"came up","gloss_zh":"升起来"}]},{"id":"s13","text":"The bird opened his wings.","separator_after":" ","translation_zh":"鸟儿展开了他的翅膀。","tokens":[{"start":0,"end":3,"surface":"The","lemma":"the","pos":"限定词","gloss_zh":"那只"},{"start":4,"end":8,"surface":"bird","lemma":"bird","pos":"名词","gloss_zh":"鸟儿"},{"start":9,"end":15,"surface":"opened","lemma":"open","pos":"动词","gloss_zh":"张开"},{"start":16,"end":19,"surface":"his","lemma":"his","pos":"代词","gloss_zh":"鸟儿的"},{"start":20,"end":25,"surface":"wings","lemma":"wing","pos":"名词","gloss_zh":"翅膀"}],"phrases":[]},{"id":"s14","text":"He flew away, singing in the light.","separator_after":"","translation_zh":"他飞走了，在光里唱着歌。","tokens":[{"start":0,"end":2,"surface":"He","lemma":"he","pos":"代词","gloss_zh":"变成鸟的男孩"},{"start":3,"end":7,"surface":"flew","lemma":"fly","pos":"动词","gloss_zh":"飞"},{"start":8,"end":12,"surface":"away","lemma":"away","pos":"副词","gloss_zh":"离开"},{"start":14,"end":21,"surface":"singing","lemma":"sing","pos":"动词","gloss_zh":"唱歌"},{"start":22,"end":24,"surface":"in","lemma":"in","pos":"介词","gloss_zh":"在"},{"start":25,"end":28,"surface":"the","lemma":"the","pos":"限定词","gloss_zh":"这片"},{"start":29,"end":34,"surface":"light","lemma":"light","pos":"名词","gloss_zh":"光亮"}],"phrases":[{"start":3,"end":12,"surface":"flew away","gloss_zh":"飞走"}]}]}],"rights":{"kind":"CC-BY","author":"Southern African Folktale","source_url":"https://www.storybookscanada.ca/stories/en/0337/","license_url":"https://creativecommons.org/licenses/by/3.0/","modifications":"简化句法和词汇，保留完整民间故事。 中文翻译及词注。"}}
