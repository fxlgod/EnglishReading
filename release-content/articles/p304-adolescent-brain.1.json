arator_after":" ","translation_zh":"脑成像研究表明，灰质在整个青少年时期会逐渐减少。","tokens":[{"start":0,"end":5,"surface":"Brain","lemma":"brain","pos":"名词","gloss_zh":"大脑"},{"start":6,"end":13,"surface":"imaging","lemma":"imaging","pos":"名词","gloss_zh":"成像"},{"start":14,"end":21,"surface":"studies","lemma":"study","pos":"名词","gloss_zh":"研究"},{"start":22,"end":26,"surface":"show","lemma":"show","pos":"动词","gloss_zh":"表明"},{"start":27,"end":31,"surface":"that","lemma":"that","pos":"从属连词","gloss_zh":"即"},{"start":32,"end":36,"surface":"gray","lemma":"gray","pos":"形容词","gloss_zh":"灰色的"},{"start":37,"end":43,"surface":"matter","lemma":"matter","pos":"名词","gloss_zh":"物质；质"},{"start":44,"end":53,"surface":"gradually","lemma":"gradually","pos":"副词","gloss_zh":"逐渐地"},{"start":54,"end":63,"surface":"decreases","lemma":"decrease","pos":"动词","gloss_zh":"减少"},{"start":64,"end":70,"surface":"across","lemma":"across","pos":"介词","gloss_zh":"贯穿"},{"start":71,"end":74,"surface":"the","lemma":"the","pos":"定冠词","gloss_zh":"这"},{"start":75,"end":82,"surface":"teenage","lemma":"teenage","pos":"形容词","gloss_zh":"青少年的"},{"start":83,"end":88,"surface":"years","lemma":"year","pos":"名词","gloss_zh":"岁月；时期"}],"phrases":[{"start":0,"end":13,"surface":"Brain imaging","gloss_zh":"脑成像"},{"start":32,"end":43,"surface":"gray matter","gloss_zh":"灰质"},{"start":75,"end":88,"surface":"teenage years","gloss_zh":"青少年时期"}]},{"id":"s7","text":"Neuroscientists think this decrease reflects the fine-tuning of connections between brain cells, where frequently used pathways are reinforced while less active ones are pruned away.","separator_after":" ","translation_zh":"神经科学家认为，这种减少反映了脑细胞间连接的精细调谐：经常使用的神经通路得到强化，而较少活跃的通路则被修剪剔除。","tokens":[{"start":0,"end":15,"surface":"Neuroscientists","lemma":"neuroscientist","pos":"名词","gloss_zh":"神经科学家"},{"start":16,"end":21,"surface":"think","lemma":"think","pos":"动词","gloss_zh":"认为"},{"start":22,"end":26,"surface":"this","lemma":"this","pos":"限定词","gloss_zh":"这种"},{"start":27,"end":35,"surface":"decrease","lemma":"decrease","pos":"名词","gloss_zh":"减少"},{"start":36,"end":44,"surface":"reflects","lemma":"reflect","pos":"动词","gloss_zh":"反映"},{"start":45,"end":48,"surface":"the","lemma":"the","pos":"定冠词","gloss_zh":"这种"},{"start":49,"end":60,"surface":"fine-tuning","lemma":"fine-tuning","pos":"名词","gloss_zh":"精细调谐"},{"start":61,"end":63,"surface":"of","lemma":"of","pos":"介词","gloss_zh":"……的"},{"start":64,"end":75,"surface":"connections","lemma":"connection","pos":"名词","gloss_zh":"连接"},{"start":76,"end":83,"surface":"between","lemma":"between","pos":"介词","gloss_zh":"在……之间"},{"start":84,"end":89,"surface":"brain","lemma":"brain","pos":"名词","gloss_zh":"大脑"},{"start":90,"end":95,"surface":"cells","lemma":"cell","pos":"名词","gloss_zh":"细胞"},{"start":97,"end":102,"surface":"where","lemma":"where","pos":"关系副词","gloss_zh":"在其中"},{"start":103,"end":113,"surface":"frequently","lemma":"frequently","pos":"副词","gloss_zh":"频繁地"},{"start":114,"end":118,"surface":"used","lemma":"use","pos":"形容词","gloss_zh":"被使用的"},{"start":119,"end":127,"surface":"pathways","lemma":"pathway","pos":"名词","gloss_zh":"通路"},{"start":128,"end":131,"surface":"are","lemma":"be","pos":"助动词","gloss_zh":"被"},{"start":132,"end":142,"surface":"reinforced","lemma":"reinforce","pos":"动词","gloss_zh":"强化"},{"start":143,"end":148,"surface":"while","lemma":"while","pos":"连词","gloss_zh":"而"},{"start":149,"end":153,"surface":"less","lemma":"less","pos":"副词","gloss_zh":"较不"},{"start":154,"end":160,"surface":"active","lemma":"active","pos":"形容词","gloss_zh":"活跃的"},{"start":161,"end":165,"surface":"ones","lemma":"one","pos":"代词","gloss_zh":"那些（通路）"},{"start":166,"end":169,"surface":"are","lemma":"be","pos":"助动词","gloss_zh":"被"},{"start":170,"end":176,"surface":"pruned","lemma":"prune","pos":"动词","gloss_zh":"修剪"},{"start":177,"end":181,"surface":"away","lemma":"away","pos":"副词","gloss_zh":"除去"}],"phrases":[{"start":84,"end":95,"surface":"brain cells","gloss_zh":"脑细胞"},{"start":170,"end":181,"surface":"pruned away","gloss_zh":"修剪掉；剔除"}]},{"id":"s8","text":"At the same time, white matter—the long fibers that transmit signals between different regions—increases into the mid-teens, which is thought to support faster communication across the brain.","separator_after":"","translation_zh":"与此同时，负责在不同脑区之间传递信号的细长纤维——白质——在进入十几岁中期时会增加，这被认为能够支持全脑范围内更迅速的信息交流。","tokens":[{"start":0,"end":2,"surface":"At","lemma":"at","pos":"介词","gloss_zh":"在"},{"start":3,"end":6,"surface":"the","lemma":"the","pos":"定冠词","gloss_zh":"这"},{"start":7,"end":11,"surface":"same","lemma":"same","pos":"形容词","gloss_zh":"相同的"},{"start":12,"end":16,"surface":"time","lemma":"time","pos":"名词","gloss_zh":"时间"},{"start":18,"end":23,"surface":"white","lemma":"white","pos":"形容词","gloss_zh":"白色的"},{"start":24,"end":30,"surface":"matter","lemma":"matter","pos":"名词","gloss_zh":"物质；质"},{"start":31,"end":34,"surface":"the","lemma":"the","pos":"定冠词","gloss_zh":"这些"},{"start":35,"end":39,"surface":"long","lemma":"long","pos":"形容词","gloss_zh":"细长的"},{"start":40,"end":46,"surface":"fibers","lemma":"fiber","pos":"名词","gloss_zh":"纤维"},{"start":47,"end":51,"surface":"that","lemma":"that","pos":"关系代词","gloss_zh":"它们"},{"start":52,"end":60,"surface":"transmit","lemma":"transmit","pos":"动词","gloss_zh":"传递"},{"start":61,"end":68,"surface":"signals","lemma":"signal","pos":"名词","gloss_zh":"信号"},{"start":69,"end":76,"surface":"between","lemma":"between","pos":"介词","gloss_zh":"在……之间"},{"start":77,"end":86,"surface":"different","lemma":"different","pos":"形容词","gloss_zh":"不同的"},{"start":87,"end":94,"surface":"regions","lemma":"region","pos":"名词","gloss_zh":"区域"},{"start":95,"end":104,"surface":"increases","lemma":"increase","pos":"动词","gloss_zh":"增加"},{"start":105,"end":109,"surface":"into","lemma":"into","pos":"介词","gloss_zh":"进入"},{"start":110,"end":113,"surface":"the","lemma":"the","pos":"定冠词","gloss_zh":"这"},{"start":114,"end":123,"surface":"mid-teens","lemma":"mid-teen","pos":"名词","gloss_zh":"十几岁中期"},{"start":125,"end":130,"surface":"which","lemma":"which","pos":"关系代词","gloss_zh":"这一点"},{"start":131,"end":133,"surface":"is","lemma":"be","pos":"助动词","gloss_zh":"被"},{"start":134,"end":141,"surface":"thought","lemma":"think","pos":"动词","gloss_zh":"认为"},{"start":142,"end":144,"surface":"to","lemma":"to","pos":"不定式标记","gloss_zh":"去"},{"start":145,"end":152,"surface":"support","lemma":"support","pos":"动词","gloss_zh":"支持"},{"start":153,"end":159,"surface":"faster","lemma":"fast","pos":"形容词比较级","gloss_zh":"更快的"},{"start":160,"end":173,"surface":"communication","lemma":"communication","pos":"名词","gloss_zh":"通信；交流"},{"start":174,"end":180,"surface":"across","lemma":"across","pos":"介词","gloss_zh":"跨越"},{"start":181,"end":184,"surface":"the","lemma":"the","pos":"定冠词","gloss_zh":"这"},{"start":185,"end":190,"surface":"brain","lemma":"brain","pos":"名词","gloss_zh":"大脑"}],"phrases":[{"start":0,"end":16,"surface":"At the same time","gloss_zh":"与此同时"},{"start":18,"end":30,"surface":"white matter","gloss_zh":"白质"}]}]},{"sentences":[{"id":"s9","text":"Scientists also study how brain regions connect functionally.","separator_after":" ","translation_zh":"科学家们还在研究各个大脑区域如何在功能上建立连接。","tokens":[{"start":0,"end":10,"surface":"Scientists","lemma":"scientist","pos":"名词","gloss_zh":"科学家"},{"start":11,"end":15,"surface":"also","lemma":"also","pos":"副词","gloss_zh":"也"},{"start":16,"end":21,"surface":"study","lemma":"study","pos":"动词","gloss_zh":"研究"},{"start":22,"end":25,"surface":"how","lemma":"how","pos":"副词","gloss_zh":"如何"},{"start":26,"end":31,"surface":"brain","lemma":"brain","pos":"名词","gloss_zh":"大脑"},{"start":32,"end":39,"surface":"regions","lemma":"region","pos":"名词","gloss_zh":"区域"},{"start":40,"end":47,"surface":"connect","lemma":"connect","pos":"动词","gloss_zh":"连接"},{"start":48,"end":60,"surface":"functionally","lemma":"functionally","pos":"副词","gloss_zh":"功能上"}],"phrases":[{"start":26,"end":39,"surface":"brain regions","gloss_zh":"大脑区域"}]},{"id":"s10","text":"As teenagers explore new environments and interact with peers, brain networks adjust to these experiences.","separator_after":" ","translation_zh":"随着青少年探索新环境并与同伴互动，大脑网络会根据这些经历进行自我调整。","tokens":[{"start":0,"end":2,"surface":"As","lemma":"as","pos":"从属连词","gloss_zh":"随着"},{"start":3,"end":12,"surface":"teenagers","lemma":"teenager","pos":"名词","gloss_zh":"青少年"},{"start":13,"end":20,"surface":"explore","lemma":"explore","pos":"动词","gloss_zh":"探索"},{"start":21,"end":24,"surface":"new","lemma":"new","pos":"形容词","gloss_zh":"新的"},{"start":25,"end":37,"surface":"environments","lemma":"environment","pos":"名词","gloss_zh":"环境"},{"start":38,"end":41,"surface":"and","lemma":"and","pos":"连词","gloss_zh":"并"},{"start":42,"end":50,"surface":"interact","lemma":"interact","pos":"动词","gloss_zh":"互动"},{"start":51,"end":55,"surface":"with","lemma":"with","pos":"介词","gloss_zh":"与……"},{"start":56,"end":61,"surface":"peers","lemma":"peer","pos":"名词","gloss_zh":"同伴"},{"start":63,"end":68,"surface":"brain","lemma":"brain","pos":"名词","gloss_zh":"大脑"},{"start":69,"end":77,"surface":"networks","lemma":"network","pos":"名词","gloss_zh":"网络"},{"start":78,"end":84,"surface":"adjust","lemma":"adjust","pos":"动词","gloss_zh":"调节；适应"},{"start":85,"end":87,"surface":"to","lemma":"to","pos":"介词","gloss_zh":"向……"},{"start":88,"end":93,"surface":"these","lemma":"these","pos":"限定词","gloss_zh":"这些"},{"start":94,"end":105,"surface":"experiences","lemma":"experience","pos":"名词","gloss_zh":"经历"}],"phrases":[{"start":42,"end":55,"surface":"interact with","gloss_zh":"与……互动"},{"start":63,"end":77,"surface":"brain networks","gloss_zh":"大脑网络"},{"start":78,"end":87,"surface":"adjust to","gloss_zh":"适应……；调整以应对"}]},{"id":"s11","text":"Importantly, researchers emphasize that not every teenager has the same brain organization.","separator_after":" ","translation_zh":"重要的是，研究人员强调，并非每个青少年都拥有相同的大脑组织结构。","tokens":[{"start":0,"end":11,"surface":"Importantly","lemma":"importantly","pos":"副词","gloss_zh":"重要的是"},{"start":13,"end":24,"surface":"researchers","lemma":"researcher","pos":"名词","gloss_zh":"