{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:englishreading:series:v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "synopsis_zh"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,79}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "synopsis_zh": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    }
  }
}
