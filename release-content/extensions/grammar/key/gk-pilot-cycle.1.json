{"schema_version":1,"kind":"key","id":"gk-pilot-cycle","revision":1,"exercise_id":"ge-pilot-cycle","exercise_revision":1,"passage_sha256":"55cb9287121b79e4538281c0717161c90b68a0e0f221f25b2fcc6dfb5a1c88a4","answers":[{"blank_id":"b1","canonical_answer":"the","accepted_variants":["a"],"explanation_zh":"the 可指 Leo 平时经过的那座桥；a 可在叙述中首次引入一座跨铁路的桥。over the railway 只交代桥的位置。","knowledge_tags":["定冠词","不定冠词"]},{"blank_id":"b2","canonical_answer":"was closed","accepted_variants":["closed","had closed","had been closed"],"explanation_zh":"was closed 叙述过去封桥的情形，closed 可表示停止通行。以 Leo 改道为参照回看先前封桥，可用 had closed 或 had been closed。","knowledge_tags":["一般过去时","过去完成时","被动语态"]},{"blank_id":"b3","canonical_answer":"which","accepted_variants":[],"explanation_zh":"in which 指在这座花园里。in 后须接关系代词 which，组成非限制性定语从句。","knowledge_tags":["介词加关系代词","非限制性定语从句"]},{"blank_id":"b4","canonical_answer":"to move","accepted_variants":[],"explanation_zh":"stop to do 表示停下原先的动作去做另一件事。it 指倒在路上的路牌；stopped moving it 则会变成停止正在移牌。","knowledge_tags":["目的不定式","stop 的不定式补语"]},{"blank_id":"b5","canonical_answer":"safer","accepted_variants":[],"explanation_zh":"与 busy road 比较，用 safer。","knowledge_tags":["比较级"]},{"blank_id":"b6","canonical_answer":"continued","accepted_variants":[],"explanation_zh":"叙述当时依次发生的两个过去动作。","knowledge_tags":["一般过去时"]},{"blank_id":"b7","canonical_answer":"careful","accepted_variants":[],"explanation_zh":"be 后用形容词 careful 作表语；be careful not to do 表示小心避免做某事，not 否定 ride。","knowledge_tags":["词形转换","形容词作表语"]},{"blank_id":"b8","canonical_answer":"longer","accepted_variants":[],"explanation_zh":"a little 修饰比较级，表示耗时稍长。","knowledge_tags":["比较级"]},{"blank_id":"b9","canonical_answer":"how","accepted_variants":[],"explanation_zh":"how to reach 表示怎样到达。","knowledge_tags":["疑问词加不定式"]},{"blank_id":"b10","canonical_answer":"to help","accepted_variants":[],"explanation_zh":"in order to do 表示目的。","knowledge_tags":["目的状语"]}]}
