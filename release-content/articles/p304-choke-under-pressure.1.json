还指出，在考前把自己的想法和担忧写在纸上能够帮助减少临场失常，这可能是通过将干扰思绪移出工作记忆，从而让你专注于考试。","tokens":[{"start":0,"end":7,"surface":"Studies","lemma":"study","pos":"名词","gloss_zh":"研究"},{"start":8,"end":12,"surface":"also","lemma":"also","pos":"副词","gloss_zh":"也"},{"start":13,"end":21,"surface":"indicate","lemma":"indicate","pos":"动词","gloss_zh":"指出"},{"start":22,"end":26,"surface":"that","lemma":"that","pos":"从属连词","gloss_zh":"即"},{"start":27,"end":34,"surface":"writing","lemma":"write","pos":"动词","gloss_zh":"写"},{"start":35,"end":39,"surface":"down","lemma":"down","pos":"副词","gloss_zh":"下来"},{"start":40,"end":44,"surface":"your","lemma":"your","pos":"代词","gloss_zh":"你的"},{"start":45,"end":53,"surface":"thoughts","lemma":"thought","pos":"名词","gloss_zh":"想法"},{"start":54,"end":57,"surface":"and","lemma":"and","pos":"连词","gloss_zh":"和"},{"start":58,"end":65,"surface":"worries","lemma":"worry","pos":"名词","gloss_zh":"担忧"},{"start":66,"end":68,"surface":"on","lemma":"on","pos":"介词","gloss_zh":"在……上"},{"start":69,"end":74,"surface":"paper","lemma":"paper","pos":"名词","gloss_zh":"纸张"},{"start":75,"end":81,"surface":"before","lemma":"before","pos":"介词","gloss_zh":"在……之前"},{"start":82,"end":84,"surface":"an","lemma":"an","pos":"冠词","gloss_zh":"一场"},{"start":85,"end":89,"surface":"exam","lemma":"exam","pos":"名词","gloss_zh":"考试"},{"start":90,"end":93,"surface":"can","lemma":"can","pos":"情态动词","gloss_zh":"能够"},{"start":94,"end":98,"surface":"help","lemma":"help","pos":"动词","gloss_zh":"帮助"},{"start":99,"end":105,"surface":"reduce","lemma":"reduce","pos":"动词","gloss_zh":"减少"},{"start":106,"end":113,"surface":"choking","lemma":"choke","pos":"动词","gloss_zh":"失常"},{"start":115,"end":123,"surface":"probably","lemma":"probably","pos":"副词","gloss_zh":"大概；可能"},{"start":124,"end":126,"surface":"by","lemma":"by","pos":"介词","gloss_zh":"通过"},{"start":127,"end":134,"surface":"getting","lemma":"get","pos":"动词","gloss_zh":"清除"},{"start":135,"end":146,"surface":"distracting","lemma":"distract","pos":"形容词","gloss_zh":"分散注意力的"},{"start":147,"end":155,"surface":"thoughts","lemma":"thought","pos":"名词","gloss_zh":"思绪"},{"start":156,"end":159,"surface":"out","lemma":"out","pos":"副词","gloss_zh":"移出"},{"start":160,"end":162,"surface":"of","lemma":"of","pos":"介词","gloss_zh":"……之外"},{"start":163,"end":170,"surface":"working","lemma":"working","pos":"形容词","gloss_zh":"工作"},{"start":171,"end":177,"surface":"memory","lemma":"memory","pos":"名词","gloss_zh":"记忆"},{"start":178,"end":180,"surface":"so","lemma":"so","pos":"连词","gloss_zh":"以便"},{"start":181,"end":184,"surface":"you","lemma":"you","pos":"代词","gloss_zh":"你"},{"start":185,"end":188,"surface":"can","lemma":"can","pos":"情态动词","gloss_zh":"能够"},{"start":189,"end":194,"surface":"focus","lemma":"focus","pos":"动词","gloss_zh":"集中"},{"start":195,"end":197,"surface":"on","lemma":"on","pos":"介词","gloss_zh":"在……上"},{"start":198,"end":201,"surface":"the","lemma":"the","pos":"定冠词","gloss_zh":"这场"},{"start":202,"end":206,"surface":"test","lemma":"test","pos":"名词","gloss_zh":"考试"}],"phrases":[{"start":27,"end":39,"surface":"writing down","gloss_zh":"写下；记下"},{"start":156,"end":162,"surface":"out of","gloss_zh":"从……中移出"},{"start":163,"end":177,"surface":"working memory","gloss_zh":"工作记忆"},{"start":189,"end":197,"surface":"focus on","gloss_zh":"专注于；集中于"}]},{"id":"s19","text":"Recognizing that choking reflects how attention, emotion, and memory interact under stress—rather than a lack of ability—can help students perform at their best when it matters most.","separator_after":"","translation_zh":"认识到临场失常反映的是压力下注意力、情绪和记忆之间的相互作用——而非能力的匮乏——有助于学生在最关键的时刻发挥出最佳水平。","tokens":[{"start":0,"end":11,"surface":"Recognizing","lemma":"recognize","pos":"动词","gloss_zh":"认识到"},{"start":12,"end":16,"surface":"that","lemma":"that","pos":"从属连词","gloss_zh":"即"},{"start":17,"end":24,"surface":"choking","lemma":"choke","pos":"动词","gloss_zh":"失常"},{"start":25,"end":33,"surface":"reflects","lemma":"reflect","pos":"动词","gloss_zh":"反映"},{"start":34,"end":37,"surface":"how","lemma":"how","pos