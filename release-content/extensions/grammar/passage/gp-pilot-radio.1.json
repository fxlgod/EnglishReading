{"schema_version":1,"kind":"passage","id":"gp-pilot-radio","revision":1,"exercise_id":"ge-pilot-radio","paragraphs":[{"sentences":[{"id":"s1","text":"Our class started a lunchtime radio show last term, hoping to share news that did not appear on the school website.","separator_after":"","translation_zh":"上学期我们班开办了午间广播，希望分享一些学校网站上没有的消息。","tokens":[{"start":0,"end":3,"surface":"Our","lemma":"our","pos":"限定词","gloss_zh":"我们的"},{"start":4,"end":9,"surface":"class","lemma":"class","pos":"名词","gloss_zh":"班级"},{"start":10,"end":17,"surface":"started","lemma":"start","pos":"动词","gloss_zh":"开办"},{"start":18,"end":19,"surface":"a","lemma":"a","pos":"限定词","gloss_zh":"一档"},{"start":20,"end":29,"surface":"lunchtime","lemma":"lunchtime","pos":"名词","gloss_zh":"午间"},{"start":30,"end":35,"surface":"radio","lemma":"radio","pos":"名词","gloss_zh":"广播"},{"start":36,"end":40,"surface":"show","lemma":"show","pos":"名词","gloss_zh":"节目"},{"start":41,"end":45,"surface":"last","lemma":"last","pos":"形容词","gloss_zh":"上一个"},{"start":46,"end":50,"surface":"term","lemma":"term","pos":"名词","gloss_zh":"学期"},{"start":52,"end":58,"surface":"hoping","lemma":"hope","pos":"动词","gloss_zh":"希望"},{"start":59,"end":61,"surface":"to","lemma":"to","pos":"不定式标记","gloss_zh":"不定式标记"},{"start":62,"end":67,"surface":"share","lemma":"share","pos":"动词","gloss_zh":"分享"},{"start":68,"end":72,"surface":"news","lemma":"news","pos":"名词","gloss_zh":"消息"},{"start":73,"end":77,"surface":"that","lemma":"that","pos":"关系词","gloss_zh":"代指消息"},{"start":78,"end":81,"surface":"did","lemma":"do","pos":"助动词","gloss_zh":"构成一般过去时的助动词"},{"start":82,"end":85,"surface":"not","lemma":"not","pos":"副词","gloss_zh":"不"},{"start":86,"end":92,"surface":"appear","lemma":"appear","pos":"动词","gloss_zh":"出现"},{"start":93,"end":95,"surface":"on","lemma":"on","pos":"介词","gloss_zh":"在上面"},{"start":96,"end":99,"surface":"the","lemma":"the","pos":"限定词","gloss_zh":"该"},{"start":100,"end":106,"surface":"school","lemma":"school","pos":"名词","gloss_zh":"学校"},{"start":107,"end":114,"surface":"website","lemma":"website","pos":"名词","gloss_zh":"网站"}],"phrases":[{"surface":"lunchtime radio show","start":20,"end":40,"gloss_zh":"午间广播节目"},{"surface":"last term","start":41,"end":50,"gloss_zh":"上学期"}]}]},{"sentences":[{"id":"s2","text":"Sara, who usually hated speaking in front of people, agreed to read a short story.","separator_after":"","translation_zh":"萨拉平时很不喜欢当众讲话，但她答应朗读一篇短故事。","tokens":[{"start":0,"end":4,"surface":"Sara","lemma":"sara","pos":"名词","gloss_zh":"萨拉"},{"start":6,"end":9,"surface":"who","lemma":"who","pos":"关系词","gloss_zh":"代指萨拉"},{"start":10,"end":17,"surface":"usually","lemma":"usually","pos":"副词","gloss_zh":"通常"},{"start":18,"end":23,"surface":"hated","lemma":"hate","pos":"动词","gloss_zh":"不喜欢"},{"start":24,"end":32,"surface":"speaking","lemma":"speak","pos":"动词","gloss_zh":"讲话"},{"start":33,"end":35,"surface":"in","lemma":"in","pos":"介词","gloss_zh":"在"},{"start":36,"end":41,"surface":"front","lemma":"front","pos":"名词","gloss_zh":"前方"},{"start":42,"end":44,"surface":"of","lemma":"of","pos":"介词","gloss_zh":"的"},{"start":45,"end":51,"surface":"people","lemma":"person","pos":"名词","gloss_zh":"人们"},{"start":53,"end":59,"surface":"agreed","lemma":"agree","pos":"动词","gloss_zh":"同意"},{"start":60,"end":62,"surface":"to","lemma":"to","pos":"不定式标记","gloss_zh":"不定式标记"},{"start":63,"end":67,"surface":"read","lemma":"read","pos":"动词","gloss_zh":"朗读"},{"start":68,"end":69,"surface":"a","lemma":"a","pos":"限定词","gloss_zh":"一个"},{"start":70,"end":75,"surface":"short","lemma":"short","pos":"形容词","gloss_zh":"短的"},{"start":76,"end":81,"surface":"story","lemma":"story","pos":"名词","gloss_zh":"故事"}],"phrases":[{"surface":"in front of people","start":33,"end":51,"gloss_zh":"在别人面前"},{"surface":"agreed to read","start":53,"end":67,"gloss_zh":"答应朗读"}]}]},{"sentences":[{"id":"s3","text":"She wrote the beginning of her story on a card so that she could see it clearly while speaking.","separator_after":"","translation_zh":"她把故事开头写在卡片上，以便朗读时能