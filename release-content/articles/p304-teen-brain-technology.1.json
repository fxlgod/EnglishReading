,"end":68,"surface":"digital","lemma":"digital","pos":"形容词","gloss_zh":"数字的"},{"start":69,"end":79,"surface":"activities","lemma":"activity","pos":"名词","gloss_zh":"活动"}],"phrases":[{"start":22,"end":41,"surface":"distinguish between","gloss_zh":"在……之间区分"},{"start":42,"end":79,"surface":"active and passive digital activities","gloss_zh":"主动与被动的数字活动"}]},{"id":"s12","text":"High-quality, active engagement—such as chatting directly with friends and family, collaborating on projects, creating content, or learning through videos—is often correlated with positive feelings of connectedness.","separator_after":" ","translation_zh":"高质量的主动参与——例如与亲友直接聊天、在项目中协同合作、创作内容或通过视频学习——往往与积极的情感联结感相关。","tokens":[{"start":0,"end":12,"surface":"High-quality","lemma":"high-quality","pos":"形容词","gloss_zh":"高质量的"},{"start":14,"end":20,"surface":"active","lemma":"active","pos":"形容词","gloss_zh":"主动的"},{"start":21,"end":31,"surface":"engagement","lemma":"engagement","pos":"名词","gloss_zh":"参与；投入"},{"start":32,"end":36,"surface":"such","lemma":"such","pos":"形容词","gloss_zh":"诸如（与as连用）"},{"start":37,"end":39,"surface":"as","lemma":"as","pos":"介词","gloss_zh":"像；例如"},{"start":40,"end":48,"surface":"chatting","lemma":"chat","pos":"动词","gloss_zh":"聊天（动名词）"},{"start":49,"end":57,"surface":"directly","lemma":"directly","pos":"副词","gloss_zh":"直接地"},{"start":58,"end":62,"surface":"with","lemma":"with","pos":"介词","gloss_zh":"与……"},{"start":63,"end":70,"surface":"friends","lemma":"friend","pos":"名词","gloss_zh":"朋友"},{"start":71,"end":74,"surface":"and","lemma":"and","pos":"连词","gloss_zh":"和"},{"start":75,"end":81,"surface":"family","lemma":"family","pos":"名词","gloss_zh":"家人；家庭"},{"start":83,"end":96,"surface":"collaborating","lemma":"collaborate","pos":"动词","gloss_zh":"合作；协作（动名词）"},{"start":97,"end":99,"surface":"on","lemma":"on","pos":"介词","gloss_zh":"在……方面"},{"start":100,"end":108,"surface":"projects","lemma":"project","pos":"名词","gloss_zh":"项目；课题"},{"start":110,"end":118,"surface":"creating","lemma":"create","pos":"动词","gloss_zh":"创造；制作（动名词）"},{"start":119,"end":126,"surface":"content","lemma":"content","pos":"名词","gloss_zh":"内容"},{"start":128,"end":130,"surface":"or","lemma":"or","pos":"连词","gloss_zh":"或者"},{"start":131,"end":139,"surface":"learning","lemma":"learn","pos":"动词","gloss_zh":"学习（动名词）"},{"start":140,"end":147,"surface":"through","lemma":"through","pos":"介词","gloss_zh":"通过"},{"start":148,"end":154,"surface":"videos","lemma":"video","pos":"名词","gloss_zh":"视频"},{"start":155,"end":157,"surface":"is","lemma":"be","pos":"助动词","gloss_zh":"与correlated构成被动语态"},{"start":158,"end":163,"surface":"often","lemma":"often","pos":"副词","gloss_zh":"往往；常常"},{"start":164,"end":174,"surface":"correlated","lemma":"correlate","pos":"动词","gloss_zh":"关联；相关（与with连用）"},{"start":175,"end":179,"surface":"with","lemma":"with","pos":"介词","gloss_zh":"与……"},{"start":180,"end":188,"surface":"positive","lemma":"positive","pos":"形容词","gloss_zh":"积极的；正向的"},{"start":189,"end":197,"surface":"feelings","lemma":"feeling","pos":"名词","gloss_zh":"感受；情感"},{"start":198,"end":200,"surface":"of","lemma":"of","pos":"介词","gloss_zh":"……的"},{"start":201,"end":214,"surface":"connectedness","lemma":"connectedness","pos":"名词","gloss_zh":"联结感；亲密联系"}],"phrases":[{"start":32,"end":39,"surface":"such as","gloss_zh":"例如；诸如"},{"start":155,"end":179,"surface":"is often correlated with","gloss_zh":"往往与……相关联"},{"start":180,"end":214,"surface":"positive feelings of connectedness","gloss_zh":"积极的联结感"}]},{"id":"s13","text":"In contrast, passive scrolling and frequent upward social comparisons are more commonly linked to feelings of envy or loneliness.","separator_after":"","translation_zh":"相反，被动刷屏以及频繁的向上社交比较，则更常见地与嫉妒或孤独感产生联系。","tokens":[{"start":0,"end":2,"surface":"In","lemma":"in","pos":"介词","gloss_zh":"在……（与contrast连用）"},{"start":3,"end":11,"surface":"contrast","lemma":"contrast","pos":"名词","gloss_zh":"对比；对照"},{"start":13,"end":20,"surface":"passive","lemma":"passive","pos":"形容词","gloss_zh":"被动的"},{"start":21,"end":30