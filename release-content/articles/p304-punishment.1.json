oss_zh":"承诺；保证"}],"phrases":[]}]},{"sentences":[{"id":"s20","text":"And we all believe him.","separator_after":"","translation_zh":"我们大家都相信了他。","tokens":[{"start":0,"end":3,"surface":"And","lemma":"and","pos":"连词","gloss_zh":"并且；而且"},{"start":4,"end":6,"surface":"we","lemma":"we","pos":"代词","gloss_zh":"我们"},{"start":7,"end":10,"surface":"all","lemma":"all","pos":"副词","gloss_zh":"全都；大家"},{"start":11,"end":18,"surface":"believe","lemma":"believe","pos":"动词","gloss_zh":"相信"},{"start":19,"end":22,"surface":"him","lemma":"he","pos":"代词","gloss_zh":"他"}],"phrases":[]}]}],"rights":{"kind":"CC-BY","author":"Adelheid Marie Bwire","source_url":"https://www.storybookscanada.ca/stories/en/0342/","license_url":"https://creativecommons.org/licenses/by/3.0/","modifications":"严格保留Storybooks Canada 0342官方英文原版正文与标点符号，仅做段落排版规范化，提供逐句中文翻译与逐词语境释义。"}}
