":29,"surface":"selfish","lemma":"selfish","pos":"形容词","gloss_zh":"自私的"},{"start":32,"end":33,"surface":"I","lemma":"I","pos":"代词","gloss_zh":"我"},{"start":34,"end":37,"surface":"say","lemma":"say","pos":"动词","gloss_zh":"说"}],"phrases":[]}]},{"sentences":[{"id":"s9","text":"Mother is angry with Rahim.","separator_after":"","translation_zh":"妈妈很生拉希姆的气。","tokens":[{"start":0,"end":6,"surface":"Mother","lemma":"mother","pos":"名词","gloss_zh":"母亲；妈妈"},{"start":7,"end":9,"surface":"is","lemma":"be","pos":"系动词","gloss_zh":"是"},{"start":10,"end":15,"surface":"angry","lemma":"angry","pos":"形容词","gloss_zh":"生气的；愤怒的"},{"start":16,"end":20,"surface":"with","lemma":"with","pos":"介词","gloss_zh":"对；同"},{"start":21,"end":26,"surface":"Rahim","lemma":"Rahim","pos":"专有名词","gloss_zh":"拉希姆（人名）"}],"phrases":[{"start":10,"end":20,"surface":"angry with","gloss_zh":"生……的气"}]}]},{"sentences":[{"id":"s10","text":"We are also angry with Rahim.","separator_after":" ","translation_zh":"我们也很生拉希姆的气。","tokens":[{"start":0,"end":2,"surface":"We","lemma":"we","pos":"代词","gloss_zh":"我们"},{"start":3,"end":6,"surface":"are","lemma":"be","pos":"系动词","gloss_zh":"是"},{"start":7,"end":11,"surface":"also","lemma":"also","pos":"副词","gloss_zh":"也；同样"},{"start":12,"end":17,"surface":"angry","lemma":"angry","pos":"形容词","gloss_zh":"生气的"},{"start":18,"end":22,"surface":"with","lemma":"with","pos":"介词","gloss_zh":"对；同"},{"start":23,"end":28,"surface":"Rahim","lemma":"Rahim","pos":"专有名词","gloss_zh":"拉希姆（人名）"}],"phrases":[{"start":12,"end":22,"surface":"angry with","gloss_zh":"生……的气"}]},{"id":"s11","text":"But Rahim is not sorry.","separator_after":"","translation_zh":"但拉希姆一点也不觉得抱歉。","tokens":[{"start":0,"end":3,"surface":"But","lemma":"but","pos":"连词","gloss_zh":"但是"},{"start":4,"end":9,"surface":"Rahim","lemma":"Rahim","pos":"专有名词","gloss_zh":"拉希姆（人名）"},{"start":10,"end":12,"surface":"is","lemma":"be","pos":"系动词","gloss_zh":"是"},{"start":13,"end":16,"surface":"not","lemma":"not","pos":"副词","gloss_zh":"不；没有"},{"sta