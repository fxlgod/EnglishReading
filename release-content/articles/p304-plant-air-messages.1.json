介词","gloss_zh":"从……"},{"start":53,"end":56,"surface":"the","lemma":"the","pos":"冠词","gloss_zh":"那些"},{"start":57,"end":63,"surface":"leaves","lemma":"leaf","pos":"名词","gloss_zh":"叶片（leaf的复数）"},{"start":64,"end":68,"surface":"that","lemma":"that","pos":"代词","gloss_zh":"关系代词（引导定语从句）"},{"start":69,"end":76,"surface":"release","lemma":"release","pos":"动词","gloss_zh":"释放"},{"start":77,"end":81,"surface":"them","lemma":"they","pos":"代词","gloss_zh":"它们（代指化学物质）"}],"phrases":[{"start":36,"end":52,"surface":"spread away from","gloss_zh":"从……向外扩散"}]},{"id":"s7","text":"Scientists call these chemicals volatile organic compounds.","separator_after":" ","translation_zh":"科学家将这些化学物质称为挥发性有机化合物。","tokens":[{"start":0,"end":10,"surface":"Scientists","lemma":"scientist","pos":"名词","gloss_zh":"科学家"},{"start":11,"end":15,"surface":"call","lemma":"call","pos":"动词","gloss_zh":"称呼；称作"},{"start":16,"end":21,"surface":"these","lemma":"this","pos":"限定词","gloss_zh":"这些"},{"start":22,"end":31,"surface":"chemicals","lemma":"chemical","pos":"名词","gloss_zh":"化学物质"},{"start":32,"end":40,"surface":"volatile","lemma":"volatile","pos":"形容词","gloss_zh":"易挥发的"},{"start":41,"end":48,"surface":"organic","lemma":"organic","pos":"形容词","gloss_zh":"有机的"},{"start":49,"end":58,"surface":"compounds","lemma":"compound","pos":"名词","gloss_zh":"化合物（复数）"}],"phrases":[{"start":32,"end":58,"surface":"volatile organic compounds","gloss_zh":"挥发性有机化合物"}]},{"id":"s8","text":"The word volatile is useful here because it tells us that the chemicals can pass into the air.","separator_after":" ","translation_zh":"“挥发性”这个词在这里很有用，因为它告诉我们这些化学物质能够挥发到空气之中。","tokens":[{"start":0,"end":3,"surface":"The","lemma":"the","pos":"冠词","gloss_zh":"这个"},{"start":4,"end":8,"surface":"word","lemma":"word","pos":"名词","gloss_zh":"词语"},{"start":9,"end":17,"surface":"volatile","lemma":"volatile","pos":"名词","gloss_zh":"“挥发性”（引述词）"},{"start":18,"end":20,"surface":"is","lemma":"be","pos":"系动词","gloss_zh":"是"},{"start":21,"end":27,"surface":"useful","lemma":"useful","pos":"形容词","gloss_zh":"有用的"},{"start":28,"end":32,"surface":"here","lemma":"here","pos":"副词","gloss_zh":"在这里"},{"start":33,"end":40,"surface":"because","lemma":"because","pos":"连词","gloss_zh":"因为"},{"start":41,"end":43,"surface":"it","lemma":"it","pos":"代词","gloss_zh":"它"},{"start":44,"end":49,"surface":"tells","lemma":"tell","pos":"动词","gloss_zh":"告诉"},{"start":50,"end":52,"surface":"us","lemma":"we","pos":"代词","gloss_zh":"我们"},{"start":53,"end":57,"surface":"that","lemma":"that","pos":"连词","gloss_zh":"引导宾语从句"},{"start":58,"end":61,"surface":"the","lemma":"the","pos":"冠词","gloss_zh":"那些"},{"start":62,"end":71,"surface":"chemicals","lemma":"chemical","pos":"名词","gloss_zh":"化学物质"},{"start":72,"end":75,"surface":"can","lemma":"can","pos":"情态动词","gloss_zh":"能够"},{"start":76,"end":80,"surface":"pass","lemma":"pass","pos":"动词","gloss_zh":"进入；挥发入"},{"start":81,"end":85,"surface":"into","lemma":"into","pos":"介词","gloss_zh":"到……里面"},{"start":86,"end":89,"surface":"the","lemma":"the","pos":"冠词","gloss_zh":"那"},{"start":90,"end":93,"surface":"air","lemma":"air","pos":"名词","gloss_zh":"空气"}],"phrases":[{"start":76,"end":93,"surface":"pass into the air","gloss_zh":"挥发进入空气中"}]},{"id":"s9","text":"A plant does not need a mouth or a voice to release them.","separator_after":"","translation_zh":"植物不需要嘴巴或声音就能释放它们。","tokens":[{"start":0,"end":1,"surface":"A","lemma":"a","pos":"冠词","gloss_zh":"一株"},{"start":2,"end":7,"surface":"plant","lemma":"plant","pos":"名词","gloss_zh":"植物"},{"start":8,"end":12,"surface":"does","lemma":"do","pos":"助动词","gloss_zh":"助动词（构成否定）"},{"start":13,"end":16,"surface":"not","lemma":"not","pos":"副词","gloss_zh":"不"},{"start":17,"end":21,"surface":"need","lemma":"need","pos":"动词","gloss_zh":"需要"},{"start":22,"end":23,"surface":"a","lemma":"a","pos":"冠词","gloss_zh":"一张"},{"start":24,"end":29,"surface":"mouth","lemma":"mouth","pos":"名词","gloss_zh":"嘴巴"},{"start":30,"end":32,"surface":"or","lemma":"or","pos":"连词","gloss_zh":"或者"},{"start":33,"end":34,"