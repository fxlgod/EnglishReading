{"schema_version":1,"kind":"key","id":"gk-pilot-map","revision":1,"exercise_id":"ge-pilot-map","exercise_revision":1,"passage_sha256":"f565812d874c299ad2454585c17b8929ea18096e7ded4938a0c39c2ec656e7c8","answers":[{"blank_id":"b1","canonical_answer":"to draw","accepted_variants":[],"explanation_zh":"ask someone to do 表示请某人做事。","knowledge_tags":["不定式作宾补"]},{"blank_id":"b2","canonical_answer":"which","accepted_variants":[],"explanation_zh":"of 后用关系代词 which，指代前面标出每件展品这一做法；as a result of which 引出结果。","knowledge_tags":["介词加关系代词","非限制性定语从句"]},{"blank_id":"b3","canonical_answer":"walking","accepted_variants":[],"explanation_zh":"suggest doing 表示建议做某事。","knowledge_tags":["动名词作宾语"]},{"blank_id":"b4","canonical_answer":"easily","accepted_variants":[],"explanation_zh":"用副词修饰 could miss，表示多容易错过。","knowledge_tags":["副词"]},{"blank_id":"b5","canonical_answer":"an","accepted_variants":["one"],"explanation_zh":"首次引入箭头时可用不定冠词 an，arrow 以元音音素开头。强调只画一支时也可用 one。","knowledge_tags":["不定冠词","数词"]},{"blank_id":"b6","canonical_answer":"was printed","accepted_variants":["had been printed"],"explanation_zh":"地图是印刷的承受者。was printed 叙述过去的印刷；从后面的观察或次晨使用回看已完成的印刷，可用 had been printed。","knowledge_tags":["一般过去时被动","过去完成时被动"]},{"blank_id":"b7","canonical_answer":"asking","accepted_variants":[],"explanation_zh":"介词 without 后接动名词 asking，without asking for directions 表示没有问路。","knowledge_tags":["介词后接动名词"]},{"blank_id":"b8","canonical_answer":"saying","accepted_variants":[],"explanation_zh":"while 后接现在分词，省去与主句相同的主语及 be；说话与指楼梯同时发生。","knowledge_tags":["现在分词","时间状语从句的省略"]},{"blank_id":"b9","canonical_answer":"simpler","accepted_variants":["more simple"],"explanation_zh":"much 修饰比较级，与第一版比较。","knowledge_tags":["比较级"]},{"blank_id":"b10","canonical_answer":"what","accepted_variants":[],"explanation_zh":"what 在从句中作 needed 的宾语，指参观者真正需要的东西。","knowledge_tags":["宾语从句"]}]}
