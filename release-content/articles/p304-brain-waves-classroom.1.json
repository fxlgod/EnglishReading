emma":"during","pos":"介词","gloss_zh":"在……期间"},{"start":62,"end":63,"surface":"a","lemma":"a","pos":"冠词","gloss_zh":"一堂"},{"start":64,"end":70,"surface":"lively","lemma":"lively","pos":"形容词","gloss_zh":"生动的"},{"start":71,"end":77,"surface":"lesson","lemma":"lesson","pos":"名词","gloss_zh":"课程"}],"phrases":[{"start":16,"end":29,"surface":"interact with","gloss_zh":"与……互动"}]},{"id":"s12","text":"To investigate these questions in everyday environments, scientists have developed lightweight, portable EEG headsets.","separator_after":"","translation_zh":"为了在日常环境中探索这些问题，科学家们研制出了轻量便携的EEG头戴式设备。","tokens":[{"start":0,"end":2,"surface":"To","lemma":"to","pos":"不定式标记","gloss_zh":"为了"},{"start":3,"end":14,"surface":"investigate","lemma":"investigate","pos":"动词","gloss_zh":"探究"},{"start":15,"end":20,"surface":"these","lemma":"these","pos":"限定词","gloss_zh":"这些"},{"start":21,"end":30,"surface":"questions","lemma":"question","pos":"名词","gloss_zh":"问题"},{"start":31,"end":33,"surface":"in","lemma":"in","pos":"介词","gloss_zh":"在……中"},{"start":34,"end":42,"surface":"everyday","lemma":"everyday","pos":"形容词","gloss_zh":"日常的"},{"start":43,"end":55,"surface":"environments","lemma":"environment","pos":"名词","gloss_zh":"环境"},{"start":57,"end":67,"surface":"scientists","lemma":"scientist","pos":"名词","gloss_zh":"科学家"},{"start":68,"end":72,"surface":"have","lemma":"have","pos":"助动词","gloss_zh":"已经"},{"start":73,"end":82,"surface":"developed","lemma":"develop","pos":"动词","gloss_zh":"研发"},{"start":83,"end":94,"surface":"lightweight","lemma":"lightweight","pos":"形容词","gloss_zh":"轻巧的"},{"start":96,"end":104,"surface":"portable","lemma":"portable","pos":"形容词","gloss_zh":"便携的"},{"start":105,"end":108,"surface":"EEG","lemma":"EEG","pos":"名词","gloss_zh":"脑电"},{"start":109,"end":117,"surface":"headsets","lemma":"headset","pos":"名词","gloss_zh":"头戴设备"}],"phrases":[{"start":96,"end":117,"surface":"portable EEG headsets","gloss_zh":"便携式脑电头戴设备"}]}]},{"sentences":[{"id":"s13","text":"In a pioneering study conducted by researchers at New York University, scientists partnered with a local high school to record brain activity from a teacher and students during eleven real biology classes.","separator_after":" ","translation_zh":"在纽约大学研究人员开展的一项开创性研究中，科学家与当地一所高中合作，在十一堂真实的生物课上记录了一名老师和多名学生的大脑电活动。","tokens":[{"start":0,"end":2,"surface":"In","lemma":"in","pos":"介词","gloss_zh":"在……中"},{"start":3,"end":4,"surface":"a","lemma":"a","pos":"冠词","gloss_zh":"一项"},{"start":5,"end":15,"surface":"pioneering","lemma":"pioneer","pos":"形容词","gloss_zh":"开创性的"},{"start":16,"end":21,"surface":"study","lemma":"study","pos":"名词","gloss_zh":"研究"},{"start":22,"end":31,"surface":"conducted","lemma":"conduct","pos":"动词","gloss_zh":"开展"},{"start":32,"end":34,"surface":"by","lemma":"by","pos":"介词","gloss_zh":"由"},{"start":35,"end":46,"surface":"researchers","lemma":"researcher","pos":"名词","gloss_zh":"研究人员"},{"start":47,"end":49,"surface":"at","lemma":"at","pos":"介词","gloss_zh":"在"},{"start":50,"end":53,"surface":"New","lemma":"New","pos":"专有名词","gloss_zh":"新"},{"start":54,"end":58,"surface":"York","lemma":"York","pos":"专有名词","gloss_zh":"约"},{"start":59,"end":69,"surface":"University","lemma":"University","pos":"专有名词","gloss_zh":"大学"},{"start":71,"end":81,"surface":"scientists","lemma":"scientist","pos":"名词","gloss_zh":"科学家"},{"start":82,"end":91,"surface":"partnered","lemma":"partner","pos":"动词","gloss_zh":"合作"},{"start":92,"end":96,"surface":"with","lemma":"with","pos":"介词","gloss_zh":"与……"},{"start":97,"end":98,"surface":"a","lemma":"a","pos":"冠词","gloss_zh":"一所"},{"start":99,"end":104,"surface":"local","lemma":"local","pos":"形容词","gloss_zh":"当地的"},{"start":105,"end":109,"surface":"high","lemma":"high","pos":"形容词","gloss_zh":"高中的"},{"start":110,"end":116,"surface":"school","lemma":"school","pos":"名词","gloss_zh":"学校"},{"start":117,"end":119,"surface":"to","lemma":"to","pos":"不定式标记","gloss_zh":"去"},{"start":120,"end":126,"surface":"record","lemma":"record","pos":"动词","gloss_zh":"记录"},{"start":127,"end":132,