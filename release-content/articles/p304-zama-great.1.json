":1,"surface":"I","lemma":"I","pos":"代词","gloss_zh":"我"},{"start":2,"end":7,"surface":"reply","lemma":"reply","pos":"动词","gloss_zh":"回答"},{"start":10,"end":15,"surface":"Never","lemma":"never","pos":"副词","gloss_zh":"决不；从不"},{"start":17,"end":20,"surface":"not","lemma":"not","pos":"副词","gloss_zh":"不"},{"start":21,"end":23,"surface":"me","lemma":"I","pos":"代词","gloss_zh":"我"}],"phrases":[]}]},{"sentences":[{"id":"s9","text":"After washing, I greet Grandpa and Auntie, and wish them a good day.","separator_after":"","translation_zh":"洗漱完毕后，我向爷爷和姑姑问好，祝他们度过美好的一天。","tokens":[{"start":0,"end":5,"surface":"After","lemma":"after","pos":"介词","gloss_zh":"在……之后"},{"start":6,"end":13,"surface":"washing","lemma":"wash","pos":"动名词","gloss_zh":"洗漱"},{"start":15,"end":16,"surface":"I","lemma":"I","pos":"代词","gloss_zh":"我"},{"start":17,"end":22,"surface":"greet","lemma":"greet","pos":"动词","gloss_zh":"问候；打招呼"},{"start":23,"end":30,"surface":"Grandpa","lemma":"grandpa","pos":"名词","gloss_zh":"爷爷；外公"},{"start":31,"end":34,"surface":"and","lemma":"and","pos":"连词","gloss_zh":"和"},{"start":35,"end":41,"surface":"Auntie","lemma":"auntie","pos":"名词","gloss_zh":"阿姨；姑姑"},{"start":43,"end":46,"surface":"and","lemma":"and","pos":"连词","gloss_zh":"并且"},{"start":47,"end":51,"surface":"wish","lemma":"wish","pos":"动词","gloss_zh":"祝愿"},{"start":52,"end":56,"surface":"them","lemma":"they","pos":"代词","gloss_zh":"他们"},{"start":57,"end":58,"surface":"a","lemma":"a","pos":"冠词","gloss_zh":"一个"},{"start":59,"end":63,"surface":"good","lemma":"good","pos":"形容词","gloss_zh":"美好的"},{"start":64,"end":67,"surface":"day","lemma":"day","pos":"名词","gloss_zh":"一天"}],"phrases":[{"start":0,"end":13,"surface":"After washing","gloss_zh":"洗漱之后"},{"start":47,"end":67,"surface":"wish them a good day","gloss_zh":"祝他们度过美好的一天"}]}]},{"sentences":[{"id":"s10","text":"Then I dress myself, “I’m big now Ma,” I say.","separator_after":"","translation_zh":"然后我自己穿好衣服，对妈妈说：“我现在已经长大了。”","tokens":[{"start":0,"end":4,"surface":"Then","lemma":